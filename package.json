{
  "name": "iem-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "IEM AG website and CMS dashboard (React + Tailwind + Vite)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",

    "// server": "The API lives in server/ and has its own package.json and node_modules.",
    "server:install": "npm --prefix server install",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:seed": "npm --prefix server run seed",
    "db:migrate": "npm --prefix server run prisma:migrate",
    "db:studio": "npm --prefix server run prisma:studio",

    "// setup": "One-time: install the API, create the schema, fill it from the site's own content.",
    "setup": "npm run server:install && npm run db:migrate && npm run server:seed"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
