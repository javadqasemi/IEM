# These two carry a literal NUL byte: the "show everything" filter sentinel is
# declared as `const ALLE = "<U+0000>alle"`, with a real NUL embedded so it can
# never collide with a category or a city an editor might type.
#
# Prettier reads and rewrites a file as text, and a NUL does not reliably
# survive that round trip. Losing it is silent and total: the sentinel becomes
# the ordinary string "alle", and any project category or office city actually
# named "alle" would then collide with the filter's "show everything" state.
# See CLAUDE.md — git already reports both files as binary for the same reason.
src/components/ProjectRegister.tsx
src/components/TeamGrid.tsx

