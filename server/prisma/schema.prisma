// IEM Enterprise CMS — data model.
//
// Two ideas hold the whole thing together, and everything else follows from
// them:
//
// 1. **Content is typed rows, not tables.** `ContentType` describes a shape,
//    `ContentEntry` holds one value of it as JSON, `ContentVersion` keeps every
//    value it has ever had. The alternative — a table per section, per
//    collection, per settings group — means a migration every time the site
//    gains a field, which is exactly the coupling this project is trying to
//    remove. The trade is that the database cannot enforce the shape, so the
//    service layer validates against `ContentType.schema` before writing.
//
// 2. **The public site never reads the tables.** Publishing assembles one
//    `ContentSnapshot` — a complete `SiteContent` document — and the site
//    fetches that. So a visitor's page load is one indexed read of one row, no
//    joins, no N+1 across 30 projects and 41 people, and an editor saving a
//    draft cannot affect what is live.
//
// Everything mutable carries `deletedAt` rather than being deleted: an audit
// trail that points at rows which no longer exist is not an audit trail.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer takes the connection string here. Migrations read it from
// `prisma.config.ts`, and the client gets it through the `pg` driver adapter
// constructed in `PrismaService` — which is also what removes Prisma's Rust
// query engine from the deployment.
datasource db {
  provider = "postgresql"
}

// =====================================================================
// Identity and access
// =====================================================================

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  /// Argon2id. Null for a user who has been invited but has not set one yet.
  passwordHash String?
  name         String
  avatarUrl    String?
  status       UserStatus @default(INVITED)
  /// Base32 TOTP secret. Null means MFA is not enrolled.
  mfaSecret    String?
  mfaEnabled   Boolean    @default(false)
  locale       String     @default("de-CH")
  lastLoginAt  DateTime?
  /// Consecutive failed sign-ins; cleared on success. Drives lockout.
  failedLogins Int        @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  roles             UserRole[]
  refreshTokens     RefreshToken[]
  passwordResets    PasswordReset[]
  auditLogs         AuditLog[]
  createdEntries    ContentEntry[]    @relation("EntryCreatedBy")
  updatedEntries    ContentEntry[]    @relation("EntryUpdatedBy")
  versions          ContentVersion[]
  reviewsRequested  ReviewRequest[]   @relation("ReviewRequestedBy")
  reviewsDecided    ReviewRequest[]   @relation("ReviewDecidedBy")
  snapshots         ContentSnapshot[]
  uploads           MediaAsset[]
  settingsChanged   Setting[]
  notifications     Notification[]
  listPreferences   ListPreference[]

  /// The person behind the login, when there is one. Optional in both
  /// directions: an engineer exists before their account and after it is
  /// revoked, and a login may belong to nobody on the payroll — see the note
  /// on `Employee`.
  employee          Employee?

  @@index([status])
  @@index([deletedAt])
}

/// A named bundle of permissions. `isSystem` roles ship with the install and
/// cannot be deleted — removing "Super Admin" would lock everyone out.
model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  /// Lower sorts first in the admin UI; also the tie-break for display.
  rank        Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

/// One capability, addressed as `resource.action` — e.g. `content.publish`.
///
/// Permissions are seeded from code, never created by hand: a guard checks a
/// key that has to exist somewhere in the source anyway, so letting an admin
/// invent `content.pubish` would only ever produce a permission that grants
/// nothing and is never checked.
model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  resource    String
  action      String
  description String?
  /// Groups permissions into sections in the role editor.
  category    String  @default("Allgemein")

  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

/// One issued refresh token, stored as a hash.
///
/// Rows rather than a stateless token so a session can actually be revoked —
/// "log out everywhere" and "suspend this user now" both need a server-side
/// record to invalidate. `replacedById` chains rotations, which is what makes
/// replay of an already-used token detectable: if a revoked token is presented
/// and its successor has been used, the whole chain is dropped.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =====================================================================
// Content
// =====================================================================

enum ContentKind {
  /// Exactly one entry — the hero, the footer, the SEO defaults.
  SINGLETON
  /// Many ordered entries — projects, team, openings.
  COLLECTION
}

enum WorkflowState {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
  REJECTED
}

/// The shape of one kind of content.
///
/// `schema` is a field descriptor list the dashboard renders a form from and
/// the service validates against. It is seeded from `contentTypes.ts` rather
/// than authored in the UI: these shapes are what the React components read,
/// so a type the code does not know about would edit nothing.
model ContentType {
  key         String      @id
  kind        ContentKind
  name        String
  description String?
  /// Field descriptors — see `ContentTypeSchema` in the server source.
  schema      Json
  /// Which `SiteContent` key the published snapshot writes this under.
  contentKey  String
  /// Collections only: whether the editor can reorder entries.
  orderable   Boolean     @default(true)
  icon        String?
  rank        Int         @default(100)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  entries ContentEntry[]
}

/// One editable thing: a project, a person, the footer.
///
/// `data` is the live working copy; `ContentVersion` holds the history and
/// `publishedData` holds what the last publish froze. Keeping the published
/// copy on the row means a rollback of a draft cannot disturb what is live,
/// and the snapshot builder never has to walk the version table.
model ContentEntry {
  id            String        @id @default(cuid())
  typeKey       String
  /// Stable slug, unique within the type. Singletons use the type key.
  key           String
  locale        String        @default("de-CH")
  data          Json
  publishedData Json?
  status        WorkflowState @default(DRAFT)
  /// Kept, but left out of the site. Distinct from `deletedAt`: a hidden entry
  /// is still edited, reviewed and versioned like any other — it simply does
  /// not reach the published document. `buildSnapshot` drops it.
  hidden        Boolean       @default(false)
  position      Int           @default(0)
  version       Int           @default(1)
  createdById   String?
  updatedById   String?
  publishedAt   DateTime?
  /// Set to publish automatically at a future time.
  scheduledAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  type      ContentType      @relation(fields: [typeKey], references: [key], onDelete: Cascade)
  createdBy User?            @relation("EntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?            @relation("EntryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  versions  ContentVersion[]
  reviews   ReviewRequest[]

  @@unique([typeKey, key, locale])
  @@index([typeKey, status])
  @@index([status])
  @@index([scheduledAt])
  @@index([deletedAt])
}

/// Every value an entry has ever held, so any of them can be restored and any
/// two of them compared. Written on every save, not only on publish — "who
/// changed this and when" has to answer for drafts too.
model ContentVersion {
  id        String        @id @default(cuid())
  entryId   String
  version   Int
  data      Json
  status    WorkflowState
  note      String?
  authorId  String?
  createdAt DateTime      @default(now())

  entry  ContentEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  author User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  reviews ReviewRequest[]

  @@unique([entryId, version])
  @@index([entryId, createdAt])
}

enum ReviewState {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

/// An editor asking for a specific version to be published.
///
/// It points at the version, not the entry: approving "the entry" would
/// approve whatever it happens to say by the time someone gets to it.
model ReviewRequest {
  id            String      @id @default(cuid())
  entryId       String
  versionId     String
  state         ReviewState @default(PENDING)
  requestedById String?
  message       String?
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  entry       ContentEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  version     ContentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  requestedBy User?          @relation("ReviewRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy   User?          @relation("ReviewDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([state, createdAt])
  @@index([entryId])
}

/// One published version of the whole site.
///
/// This is what `GET /api/v1/content/published` serves and what the public
/// bundle embeds at build time. Snapshots are append-only: rolling back
/// publishes a *new* snapshot holding the old content, so the history of what
/// was live when stays intact.
model ContentSnapshot {
  id            String   @id @default(cuid())
  version       Int      @unique
  content       Json
  note          String?
  /// Set when this snapshot was produced by restoring an earlier one.
  restoredFrom  Int?
  publishedById String?
  publishedAt   DateTime @default(now())

  publishedBy User? @relation(fields: [publishedById], references: [id], onDelete: SetNull)

  @@index([publishedAt])
}

// =====================================================================
// Media
// =====================================================================

model MediaFolder {
  id        String    @id @default(cuid())
  parentId  String?
  name      String
  /// Full materialised path, e.g. `/team/portraits`. Unique, so a move is one
  /// update plus a prefix rewrite rather than a recursive walk on every read.
  path      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  parent   MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children MediaFolder[] @relation("FolderTree")
  assets   MediaAsset[]

  @@index([parentId])
}

model MediaAsset {
  id           String    @id @default(cuid())
  folderId     String?
  filename     String
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  /// SHA-256 of the bytes. Lets an upload of an identical file be recognised
  /// instead of silently duplicating it.
  checksum     String
  /// Alt text. Deliberately not optional in the UI for images — see the alt
  /// policy in docs/ARCHITECTURE.md; empty string is a valid, *deliberate*
  /// value meaning
  /// decorative, which is different from nobody having thought about it.
  alt          String    @default("")
  altDecorative Boolean  @default(false)
  caption      String?
  copyright    String?
  tags         String[]  @default([])
  /// Key in the storage adapter — a path on disk or an object key in S3.
  storageKey   String
  version      Int       @default(1)
  uploadedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  folder     MediaFolder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy User?               @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  variants   MediaVariant[]
  versions   MediaAssetVersion[]

  @@index([folderId])
  @@index([checksum])
  @@index([mimeType])
  @@index([deletedAt])
}

/// A generated derivative — the responsive `srcset` the public site is missing.
model MediaVariant {
  id         String @id @default(cuid())
  assetId    String
  label      String
  width      Int
  height     Int
  format     String
  size       Int
  storageKey String

  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, label, format])
  @@index([assetId])
}

/// Kept so "replace image" is reversible: the bytes of every superseded
/// version stay in storage until an admin prunes them.
model MediaAssetVersion {
  id         String   @id @default(cuid())
  assetId    String
  version    Int
  storageKey String
  size       Int
  mimeType   String
  note       String?
  createdAt  DateTime @default(now())

  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, version])
}

// =====================================================================
// Settings, audit, notifications
// =====================================================================

/// Global configuration, one row per key.
///
/// `secret` marks values that must never leave the server in a list response —
/// SMTP passwords, API keys. The service redacts them; the column exists so
/// that rule is data rather than a hand-maintained list in code.
model Setting {
  key         String   @id
  group       String
  value       Json
  description String?
  secret      Boolean  @default(false)
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([group])
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

/// Append-only. Nothing in the application updates or deletes these rows.
///
/// `actorEmail` is denormalised on purpose: the log has to stay readable after
/// the user record is gone, and a foreign key that has been set to null tells
/// you an action happened but not who did it.
model AuditLog {
  id         String       @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  resource   String
  resourceId String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  outcome    AuditOutcome @default(SUCCESS)
  message    String?
  /// Ties every row one request produced together.
  ///
  /// A publish writes eight rows — entries, versions, a snapshot — and without
  /// this they are eight unrelated facts. Set from `AsyncLocalStorage`, so no
  /// service has to thread it through a call chain, and a background job
  /// inherits the id of the request that enqueued it.
  ///
  /// Nullable because every row written before this column existed has none,
  /// and backfilling a correlation that was never recorded would be inventing
  /// one.
  correlationId String?
  createdAt  DateTime     @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([resource, resourceId])
  @@index([action])
  @@index([correlationId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  title     String
  body      String?
  /// Where clicking it goes in the dashboard.
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// =====================================================================
// Site-facing records
// =====================================================================

enum ApplicationStatus {
  NEW
  IN_REVIEW
  INTERVIEW
  REJECTED
  HIRED
  WITHDRAWN
}

/// A dossier submitted through the site's application form.
///
/// The form already POSTs `multipart/form-data` with exactly these fields —
/// see `BewerbungDialog`. This is the receiving end it has been waiting for.
/// Personal data, so it carries its own retention date rather than living
/// forever by default.
model JobApplication {
  id            String            @id @default(cuid())
  openingId     String?
  position      String
  firstName     String
  lastName      String
  email         String
  phone         String?
  availableFrom String?
  message       String?
  /// `[{ filename, size, mimeType, storageKey, checksum }]`.
  files         Json              @default("[]")
  status        ApplicationStatus @default(NEW)
  note          String?
  ip            String?
  userAgent     String?
  /// When this record and its files are due for deletion.
  retainUntil   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([openingId])
  @@index([retainUntil])
}

/// How one person wants to see one list (foundation stage F11).
///
/// Server-side rather than `localStorage`, and that is the decision worth
/// recording: a column arrangement that lives in the browser is lost when the
/// person opens the dashboard on the machine in the meeting room, which is
/// exactly when they need the view they built. It follows the account.
///
/// One row per user per resource. Deleting it restores the default, which is
/// why "Standard wiederherstellen" is a DELETE and not a write of the defaults
/// — storing the defaults would freeze them at whatever they were that day.
model ListPreference {
  id       String @id @default(cuid())
  userId   String
  /// `application`, `project` — the resource key from `rbac/resources.ts`.
  resource String

  /// `{ hidden: string[], sort: { field, dir }, perPage: number }`.
  ///
  /// Json rather than columns because it is a *preference*: it has no
  /// invariants, nothing joins to it, and every list will want one more thing
  /// in it. A migration per column would be a migration per whim.
  view Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource])
}

model Redirect {
  id          String   @id @default(cuid())
  from        String   @unique
  to          String
  statusCode  Int      @default(301)
  enabled     Boolean  @default(true)
  hits        Int      @default(0)
  lastHitAt   DateTime?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  /// Out of attempts. A human decides whether to retry it.
  DEAD
  CANCELLED
}

/// Background work (foundation stage F10, architecture §7.6).
///
/// A table rather than a queue server, and the trade is written down in the
/// architecture: one table plus a poller is ~200 lines, Redis is already a
/// documented dependency for the lock, and `enqueue()` is the seam that makes
/// moving to BullMQ a one-file change.
///
/// Four properties a request cannot provide and every one of these needs:
/// durable across a restart, retried with backoff, attributable to whoever
/// asked for it, and **visible** — "the export never arrived" has to have an
/// answer that is not a log file.
model Job {
  id        String    @id @default(cuid())
  /// The handler's name, from the registry in `core/jobs/catalogue.ts`.
  name      String
  payload   Json      @default("{}")
  status    JobStatus @default(QUEUED)

  /// When it may first run. Later than now for a scheduled or retried job.
  runAfter  DateTime  @default(now())
  attempts  Int       @default(0)
  maxAttempts Int     @default(3)

  startedAt   DateTime?
  finishedAt  DateTime?
  /// Milliseconds, so a job that got slower is visible before it times out.
  durationMs  Int?
  error       String?
  /// The handler's own return value, for a job whose result is the point.
  result      Json?

  /// Inherited from the request that enqueued it, so the job's audit rows
  /// group with the click that caused them.
  correlationId String?
  /// Denormalised: the actor may be deleted before the job runs.
  actorId    String?
  actorEmail String?

  /// Which worker has it. Set with the claim, so a stuck job names its holder.
  lockedBy  String?
  lockedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The claim query: the oldest due job in each status.
  @@index([status, runAfter])
  @@index([name, status])
  @@index([correlationId])
}


// =====================================================================
// The operational domain — Wave 1
// =====================================================================
//
// Everything above this line is the CMS: content, media, users, the job
// queue. Everything below is the business the firm actually runs, and the
// two halves share only `User`.
//
// The premise, from `docs/system-audit.md` §0: there was no operational
// domain model at all. A Swiss engineering office plans, delivers and bills
// against *projects* — and a project is not a row with a name. It has a
// Bauherrschaft, an object, a responsible engineer, a set of Gewerke each
// with its own budget and lead, a team, and SIA phases it is contracted to
// deliver. Each of those is a table here because each is something the firm
// asks questions about.
//
// This is the Wave 1 slice (`docs/roadmap.md` §3). `Customer`, `Building`,
// `Employee` and `Discipline` are deliberately *minimal* — enough to create
// a real project against, no more. The full CRM comes back in Wave 3 and the
// full building model (floors, systems, rooms, loads) in Wave 2. What is
// here is not a stub with the fields guessed; it is the subset of the
// documented model that `Project` requires as data.

/// Shared across the domain. `URGENT` is deliberately above `HIGH` rather
/// than a separate flag: two parallel scales get used inconsistently.
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// SIA 112 phase codes, the vocabulary the firm already plans in.
///
/// An enum *and*, later, an entity — see `docs/data-model.md` §1.1. The enum
/// is the vocabulary (`P41` means Bauprojekt everywhere); `ProjectPhase`
/// (Wave 1 module 5) is the instance of one phase on one project, with its
/// dates, its fee and its sign-off. `Project.currentPhase` below holds the
/// vocabulary only, and says so.
enum SiaPhase {
  P31 // Vorprojekt
  P32 // Bauprojekt
  P33 // Bewilligungsverfahren
  P41 // Ausschreibung
  P51 // Ausführungsprojekt
  P52 // Ausführung
  P53 // Inbetriebnahme / Abschluss
}

// ---------------------------------------------------------------------
// The firm
// ---------------------------------------------------------------------

/// Thun and Bern. **Not tenancy** — see architecture §7.8: every office sees
/// every project, and `officeId` answers "who looks after this", not "who
/// may see it". Making it a tenant boundary later is a policy change, not a
/// schema one, which is the reason it is a nullable link rather than a
/// required scope on every query.
model Office {
  id             String  @id @default(cuid())
  name           String
  address        String?
  zip            String?
  city           String?
  phone          String?
  isHeadquarters Boolean @default(false)

  employees Employee[]
  projects  Project[]
  buildings Building[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

/// A self-referencing tree. The audit's fourth known gap was that no
/// Department entity existed and the closest thing was a hardcoded option
/// list on the team content type; this closes it.
model Department {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  parentId String?
  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentTree")

  /// The head of department. `SetNull`, like every actor link: a departed
  /// employee must not cascade away the department.
  headId String?
  head   Employee? @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)

  employees Employee[] @relation("DepartmentMembers")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([parentId])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  APPRENTICE
  TEMPORARY
  CONTRACTOR
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  LEFT
}

/// The person.
///
/// Three things in this system look like "a person" and none of them is the
/// same thing: `User` is a **login**, `Employee` is a **person the firm
/// employs**, and the `team` content type is a **public portrait** on the
/// website. They have different lifecycles — an engineer exists before their
/// account and after it is revoked, and half the firm never appears on the
/// site. `userId` is the optional bridge, and it is nullable in both
/// directions on purpose.
model Employee {
  id              String  @id @default(cuid())
  personnelNumber String  @unique
  firstName       String
  lastName        String
  email           String  @unique
  phone           String?
  mobile          String?
  position        String?

  employmentType  EmploymentType @default(FULL_TIME)
  /// 1–100. A Pensum, not an FTE decimal — the firm writes "80%".
  workloadPercent Int            @default(100)
  /// Personal data. Readable only with `employee.compensation`, which is a
  /// permission separate from `employee.read`; the mapper drops it when the
  /// caller lacks it rather than the query omitting it, so there is one
  /// place to check.
  hourlyRate      Decimal?       @db.Decimal(12, 2)

  hireDate DateTime
  exitDate DateTime?
  status   EmployeeStatus @default(ACTIVE)

  departmentId String?
  department   Department? @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  officeId     String?
  office       Office?     @relation(fields: [officeId], references: [id], onDelete: SetNull)

  /// The line manager. Self-referencing; the service rejects a cycle,
  /// because the database cannot.
  managerId String?
  manager   Employee?  @relation("EmployeeLine", fields: [managerId], references: [id], onDelete: SetNull)
  reports   Employee[] @relation("EmployeeLine")

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  headOf              Department[]         @relation("DepartmentHead")
  disciplinesLed      Discipline[]         @relation("DisciplineManager")
  projectsManaged     Project[]            @relation("ProjectManager")
  memberships         ProjectMember[]
  projectDisciplines  ProjectDiscipline[]  @relation("ProjectDisciplineLead")
  customersOwned      Customer[]           @relation("CustomerOwner")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, lastName])
  @@index([departmentId])
  @@index([officeId])
}

/// Master data for a Gewerk: Heizung, Lüftung, Sanitär, Elektro…
///
/// **Deliberately not an enum**, and it is the correction with the widest
/// consequences in the model (`docs/data-model.md` §3.4). A Gewerk has a
/// Fachbereichsleiter, a fee share, its own deliverables and its own budget.
/// An enum can hold none of that, and almost every later entity — drawings,
/// issues, time entries, budgets — is scoped by discipline.
model Discipline {
  id   String @id @default(cuid())
  code String @unique
  name String

  /// The Fachbereichsleiter — who owns this Gewerk across the firm. This is
  /// the difference between a lookup table and an org chart: *who do I ask
  /// about Lüftung* should be answerable without already knowing.
  managerId String?
  manager   Employee? @relation("DisciplineManager", fields: [managerId], references: [id], onDelete: SetNull)

  /// **A token name, not a hex literal.** The drawings, the Gantt, the
  /// Kanban and the 3D scene all resolve it, so a Lüftung run is the same
  /// colour everywhere — and a literal here would be the one colour in the
  /// system that cannot answer to dark mode.
  defaultColour String @default("disc-neutral")

  /// The share of a typical fee this Gewerk carries, 0–1. What makes a new
  /// project's budget breakdown a proposal rather than an empty form.
  defaultBudgetShare Decimal? @db.Decimal(5, 4)
  defaultHourlyRate  Decimal? @db.Decimal(12, 2)

  order  Int     @default(0)
  active Boolean @default(true)

  projectDisciplines ProjectDiscipline[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([active, order])
}

// ---------------------------------------------------------------------
// The commercial side, and the object
// ---------------------------------------------------------------------

enum CustomerType {
  COMPANY
  PUBLIC_BODY
  PRIVATE
}

enum CustomerStatus {
  LEAD
  ACTIVE
  DORMANT
  ARCHIVED
}

/// Company or private client. The Wave 1 slice: enough to be a
/// Bauherrschaft. The full CRM — contacts, activity history, offers — is
/// Wave 3 module 18.
model Customer {
  id        String         @id @default(cuid())
  number    String         @unique
  name      String
  legalName String?
  /// `CHE-###.###.###` when present.
  vatNumber String?
  type      CustomerType   @default(COMPANY)
  status    CustomerStatus @default(ACTIVE)

  address String?
  zip     String?
  city    String?
  country String  @default("CH")

  phone   String?
  email   String?
  website String?
  notes   String?

  /// The account manager.
  ownerId String?
  owner   Employee? @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  buildings          Building[]
  projects           Project[] @relation("ProjectCustomer")
  projectsAsArchitect Project[] @relation("ProjectArchitect")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, name])
}

enum BuildingUsage {
  WOHNBAU
  BUERO
  INDUSTRIE
  GEWERBE
  SCHULE
  SPITAL
  SPORT
  KULTUR
  LANDWIRTSCHAFT
  ANDERE
}

enum ConstructionType {
  NEUBAU
  UMBAU
  SANIERUNG
  ERWEITERUNG
}

enum EnergyStandard {
  MINERGIE
  MINERGIE_P
  MINERGIE_A
  GEAK_A
  GEAK_B
  GEAK_C
  GEAK_D
  GEAK_E
  GEAK_F
  GEAK_G
  KEINER
}

/// The physical object, and the thing the firm's work is actually about.
///
/// **It is its own entity, not an address field on the project**, and the
/// reason is the second commission: a building outlives any one project, and
/// the refurbishment ten years after the Neubau should inherit its areas,
/// its EGID and its systems. That inheritance is most of the value of having
/// this table at all.
///
/// Wave 1 slice: the core identity and the SIA 416 figures. Floors,
/// BuildingSystems, Rooms and RoomLoads are Wave 2 module 6.
model Building {
  id     String @id @default(cuid())
  number String @unique
  name   String

  /// The Bauherrschaft. Required — a building with no owner is a landmark.
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  address String?
  zip     String?
  city    String?
  country String  @default("CH")

  parcelNumber String?
  /// The federal building identifier, eight digits.
  egid         String?
  /// LV95 E/N.
  coordinates  Json?

  usage            BuildingUsage?
  constructionType ConstructionType?
  energyStandard   EnergyStandard?

  yearBuilt             Int?
  yearRenovated         Int?
  floorCount            Int?
  undergroundFloorCount Int?

  /// SIA 416: Energiebezugsfläche, Geschossfläche, Gebäudevolumen.
  heatedArea Decimal? @db.Decimal(12, 2)
  grossArea  Decimal? @db.Decimal(12, 2)
  volume     Decimal? @db.Decimal(12, 2)

  officeId String?
  office   Office? @relation(fields: [officeId], references: [id], onDelete: SetNull)

  projects Project[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([customerId])
  @@index([city, name])
}

// ---------------------------------------------------------------------
// The project
// ---------------------------------------------------------------------

/// `PLANNED → ACTIVE → (ON_HOLD ↔ ACTIVE) → COMPLETED → ARCHIVED`, with
/// `CANCELLED` reachable from the three live states. The transitions are
/// enforced in `projects.rules.ts`, not here: Postgres can reject a typo but
/// not a sequence.
enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
  CANCELLED
}

/// Derived, never typed — see `Project.health`.
enum ProjectHealth {
  GREEN
  AMBER
  RED
}

/// The centre of the system.
model Project {
  id     String @id @default(cuid())
  /// `P-2026-014`. Allocated on create from the year and a per-year counter.
  number String @unique
  name   String

  status   ProjectStatus @default(PLANNED)
  priority Priority      @default(MEDIUM)

  /// **Derived and denormalised, for list filtering only.** The truth is the
  /// one `ProjectPhase` row that is `ACTIVE` (Wave 1 module 5). Kept here so
  /// "all projects in Ausführung" is an indexed scan rather than a join, and
  /// recomputed whenever a phase changes — never typed by a user.
  currentPhase SiaPhase?

  /// **Derived, stored for sorting.** Budget burn against progress against
  /// deadline proximity — `deriveHealth` in `projects.rules.ts` is the only
  /// writer. A stored number that should have been a computed one goes
  /// stale, which is the same discipline as the site's `{token}`
  /// placeholders, so both this and `progressPercent` are recomputed on
  /// write *and* reconciled nightly, and a test asserts the two agree.
  health ProjectHealth @default(GREEN)
  /// 0–100, derived from milestone completion.
  progressPercent Int @default(0)

  /// Required. An engineering project without a Bauherrschaft is not a
  /// project — no `onDelete`, so the database refuses to remove a customer
  /// that still has one.
  customerId String
  customer   Customer @relation("ProjectCustomer", fields: [customerId], references: [id])

  /// The architect is another company, hence a second link to `Customer`
  /// rather than a field. `SetNull` because a project survives the practice
  /// that designed it.
  architectId String?
  architect   Customer? @relation("ProjectArchitect", fields: [architectId], references: [id], onDelete: SetNull)

  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  /// The responsible engineer. Required *as data* — `ACTIVE` is refused
  /// without one — but `SetNull` at the database, because a manager leaving
  /// must not cascade away the project. The two rules are not in conflict:
  /// one is a lifecycle rule, the other is a referential one.
  managerId String?
  manager   Employee? @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  officeId String?
  office   Office? @relation(fields: [officeId], references: [id], onDelete: SetNull)

  startDate       DateTime?
  plannedEndDate  DateTime?
  actualEndDate   DateTime?

  contractValue Decimal? @db.Decimal(12, 2)
  currency      String   @default("CHF")
  budgetHours   Int?

  description String?
  notes       String?

  members     ProjectMember[]
  disciplines ProjectDiscipline[]
  milestones  Milestone[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  archivedAt  DateTime?
  createdById String?
  updatedById String?

  /// The list contract's default sort and its three commonest filters.
  @@index([status, updatedAt])
  @@index([customerId])
  @@index([managerId])
  @@index([health, plannedEndDate])
}

enum ProjectMemberRole {
  MANAGER
  ENGINEER
  DRAFTSMAN
  CONSULTANT
  APPRENTICE
}

/// Who is on the project, in what role, for what period.
///
/// The composite unique includes `from`, not just the pair: the same
/// engineer legitimately rejoins a project after a year on something else,
/// and a unique on `(projectId, employeeId)` would force that second stint
/// to overwrite the first and lose the history.
model ProjectMember {
  id         String  @id @default(cuid())
  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  role              ProjectMemberRole @default(ENGINEER)
  /// The share of this person's Pensum planned on this project, 1–100.
  allocationPercent Int               @default(100)
  from              DateTime
  to                DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([projectId, employeeId, from])
  @@index([employeeId])
}

enum ProjectDisciplineStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  NOT_IN_SCOPE
}

/// The scope of one Gewerk on one project.
///
/// This is the table that lets the system answer what an engineering office
/// actually asks: *what is the Lüftung budget on Guglera and who owns it*,
/// *how many Sanitär hours are open across all projects*, *which projects
/// have no Elektro lead*. The enum the first draft used answers none of
/// them.
model ProjectDiscipline {
  id           String  @id @default(cuid())
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  disciplineId String
  discipline   Discipline @relation(fields: [disciplineId], references: [id])

  leadEngineerId String?
  leadEngineer   Employee? @relation("ProjectDisciplineLead", fields: [leadEngineerId], references: [id], onDelete: SetNull)

  status ProjectDisciplineStatus @default(PLANNED)

  /// Percent of the project fee, 0–100. The sum across a project may exceed
  /// 100 only with `feeShareOverride` — subcontracted scope legitimately
  /// does, and refusing it outright would make the honest case impossible.
  feeShare         Decimal? @db.Decimal(5, 2)
  feeShareOverride Boolean  @default(false)

  budgetHours Int?
  budgetCost  Decimal? @db.Decimal(12, 2)
  /// Overrides `Discipline.defaultHourlyRate` for this project.
  hourlyRate  Decimal? @db.Decimal(12, 2)
  scopeNote   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([projectId, disciplineId])
  @@index([disciplineId, status])
}

enum MilestoneStatus {
  OPEN
  AT_RISK
  MET
  MISSED
  WAIVED
}

/// A dated commitment on a project. `progressPercent` is computed from these.
model Milestone {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name    String
  dueDate DateTime
  metAt   DateTime?
  status  MilestoneStatus @default(OPEN)
  phase   SiaPhase?

  /// What connects Planning to Finance: meeting such a milestone raises
  /// `MilestoneReached`, and Finance may create an invoice draft from it.
  isBillingTrigger Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([projectId, dueDate])
  @@index([status, dueDate])
}
