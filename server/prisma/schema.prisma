// IEM Enterprise CMS — data model.
//
// Two ideas hold the whole thing together, and everything else follows from
// them:
//
// 1. **Content is typed rows, not tables.** `ContentType` describes a shape,
//    `ContentEntry` holds one value of it as JSON, `ContentVersion` keeps every
//    value it has ever had. The alternative — a table per section, per
//    collection, per settings group — means a migration every time the site
//    gains a field, which is exactly the coupling this project is trying to
//    remove. The trade is that the database cannot enforce the shape, so the
//    service layer validates against `ContentType.schema` before writing.
//
// 2. **The public site never reads the tables.** Publishing assembles one
//    `ContentSnapshot` — a complete `SiteContent` document — and the site
//    fetches that. So a visitor's page load is one indexed read of one row, no
//    joins, no N+1 across 30 projects and 41 people, and an editor saving a
//    draft cannot affect what is live.
//
// Everything mutable carries `deletedAt` rather than being deleted: an audit
// trail that points at rows which no longer exist is not an audit trail.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer takes the connection string here. Migrations read it from
// `prisma.config.ts`, and the client gets it through the `pg` driver adapter
// constructed in `PrismaService` — which is also what removes Prisma's Rust
// query engine from the deployment.
datasource db {
  provider = "postgresql"
}

// =====================================================================
// Identity and access
// =====================================================================

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  /// Argon2id. Null for a user who has been invited but has not set one yet.
  passwordHash String?
  name         String
  avatarUrl    String?
  status       UserStatus @default(INVITED)
  /// Base32 TOTP secret. Null means MFA is not enrolled.
  mfaSecret    String?
  mfaEnabled   Boolean    @default(false)
  locale       String     @default("de-CH")
  lastLoginAt  DateTime?
  /// Consecutive failed sign-ins; cleared on success. Drives lockout.
  failedLogins Int        @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  roles             UserRole[]
  refreshTokens     RefreshToken[]
  passwordResets    PasswordReset[]
  auditLogs         AuditLog[]
  createdEntries    ContentEntry[]    @relation("EntryCreatedBy")
  updatedEntries    ContentEntry[]    @relation("EntryUpdatedBy")
  versions          ContentVersion[]
  reviewsRequested  ReviewRequest[]   @relation("ReviewRequestedBy")
  reviewsDecided    ReviewRequest[]   @relation("ReviewDecidedBy")
  snapshots         ContentSnapshot[]
  uploads           MediaAsset[]
  settingsChanged   Setting[]
  notifications     Notification[]
  listPreferences   ListPreference[]
  organisationEdits Organisation[]
  officeEdits       Office[]          @relation("OfficeUpdatedBy")

  /// The person behind the login, when there is one. Optional in both
  /// directions: an engineer exists before their account and after it is
  /// revoked, and a login may belong to nobody on the payroll — see the note
  /// on `Employee`.
  employee Employee?

  @@index([status])
  @@index([deletedAt])
}

/// A named bundle of permissions. `isSystem` roles ship with the install and
/// cannot be deleted — removing "Super Admin" would lock everyone out.
model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  /// Lower sorts first in the admin UI; also the tie-break for display.
  rank        Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

/// One capability, addressed as `resource.action` — e.g. `content.publish`.
///
/// Permissions are seeded from code, never created by hand: a guard checks a
/// key that has to exist somewhere in the source anyway, so letting an admin
/// invent `content.pubish` would only ever produce a permission that grants
/// nothing and is never checked.
model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  resource    String
  action      String
  description String?
  /// Groups permissions into sections in the role editor.
  category    String  @default("Allgemein")

  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

/// One issued refresh token, stored as a hash.
///
/// Rows rather than a stateless token so a session can actually be revoked —
/// "log out everywhere" and "suspend this user now" both need a server-side
/// record to invalidate. `replacedById` chains rotations, which is what makes
/// replay of an already-used token detectable: if a revoked token is presented
/// and its successor has been used, the whole chain is dropped.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =====================================================================
// Content
// =====================================================================

enum ContentKind {
  /// Exactly one entry — the hero, the footer, the SEO defaults.
  SINGLETON
  /// Many ordered entries — projects, team, openings.
  COLLECTION
}

enum WorkflowState {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
  REJECTED
}

/// The shape of one kind of content.
///
/// `schema` is a field descriptor list the dashboard renders a form from and
/// the service validates against. It is seeded from `contentTypes.ts` rather
/// than authored in the UI: these shapes are what the React components read,
/// so a type the code does not know about would edit nothing.
model ContentType {
  key         String      @id
  kind        ContentKind
  name        String
  description String?
  /// Field descriptors — see `ContentTypeSchema` in the server source.
  schema      Json
  /// Which `SiteContent` key the published snapshot writes this under.
  contentKey  String
  /// Collections only: whether the editor can reorder entries.
  orderable   Boolean     @default(true)
  icon        String?
  rank        Int         @default(100)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  entries ContentEntry[]
}

/// One editable thing: a project, a person, the footer.
///
/// `data` is the live working copy; `ContentVersion` holds the history and
/// `publishedData` holds what the last publish froze. Keeping the published
/// copy on the row means a rollback of a draft cannot disturb what is live,
/// and the snapshot builder never has to walk the version table.
model ContentEntry {
  id            String        @id @default(cuid())
  typeKey       String
  /// Stable slug, unique within the type. Singletons use the type key.
  key           String
  locale        String        @default("de-CH")
  data          Json
  publishedData Json?
  status        WorkflowState @default(DRAFT)
  /// Kept, but left out of the site. Distinct from `deletedAt`: a hidden entry
  /// is still edited, reviewed and versioned like any other — it simply does
  /// not reach the published document. `buildSnapshot` drops it.
  hidden        Boolean       @default(false)
  position      Int           @default(0)
  version       Int           @default(1)
  createdById   String?
  updatedById   String?
  publishedAt   DateTime?
  /// Set to publish automatically at a future time.
  scheduledAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  type      ContentType      @relation(fields: [typeKey], references: [key], onDelete: Cascade)
  createdBy User?            @relation("EntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?            @relation("EntryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  versions  ContentVersion[]
  reviews   ReviewRequest[]

  @@unique([typeKey, key, locale])
  @@index([typeKey, status])
  @@index([status])
  @@index([scheduledAt])
  @@index([deletedAt])
}

/// Every value an entry has ever held, so any of them can be restored and any
/// two of them compared. Written on every save, not only on publish — "who
/// changed this and when" has to answer for drafts too.
model ContentVersion {
  id        String        @id @default(cuid())
  entryId   String
  version   Int
  data      Json
  status    WorkflowState
  note      String?
  authorId  String?
  createdAt DateTime      @default(now())

  entry   ContentEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  author  User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  reviews ReviewRequest[]

  @@unique([entryId, version])
  @@index([entryId, createdAt])
}

enum ReviewState {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

/// An editor asking for a specific version to be published.
///
/// It points at the version, not the entry: approving "the entry" would
/// approve whatever it happens to say by the time someone gets to it.
model ReviewRequest {
  id            String      @id @default(cuid())
  entryId       String
  versionId     String
  state         ReviewState @default(PENDING)
  requestedById String?
  message       String?
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  entry       ContentEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  version     ContentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  requestedBy User?          @relation("ReviewRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy   User?          @relation("ReviewDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([state, createdAt])
  @@index([entryId])
}

/// One published version of the whole site.
///
/// This is what `GET /api/v1/content/published` serves and what the public
/// bundle embeds at build time. Snapshots are append-only: rolling back
/// publishes a *new* snapshot holding the old content, so the history of what
/// was live when stays intact.
model ContentSnapshot {
  id            String   @id @default(cuid())
  version       Int      @unique
  content       Json
  note          String?
  /// Set when this snapshot was produced by restoring an earlier one.
  restoredFrom  Int?
  publishedById String?
  publishedAt   DateTime @default(now())

  publishedBy User? @relation(fields: [publishedById], references: [id], onDelete: SetNull)

  @@index([publishedAt])
}

// =====================================================================
// Media
// =====================================================================

model MediaFolder {
  id        String    @id @default(cuid())
  parentId  String?
  name      String
  /// Full materialised path, e.g. `/team/portraits`. Unique, so a move is one
  /// update plus a prefix rewrite rather than a recursive walk on every read.
  path      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  parent   MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children MediaFolder[] @relation("FolderTree")
  assets   MediaAsset[]

  @@index([parentId])
}

model MediaAsset {
  id            String    @id @default(cuid())
  folderId      String?
  filename      String
  originalName  String
  mimeType      String
  size          Int
  width         Int?
  height        Int?
  /// SHA-256 of the bytes. Lets an upload of an identical file be recognised
  /// instead of silently duplicating it.
  checksum      String
  /// Alt text. Deliberately not optional in the UI for images — see the alt
  /// policy in docs/ARCHITECTURE.md; empty string is a valid, *deliberate*
  /// value meaning
  /// decorative, which is different from nobody having thought about it.
  alt           String    @default("")
  altDecorative Boolean   @default(false)
  caption       String?
  copyright     String?
  tags          String[]  @default([])
  /// Key in the storage adapter — a path on disk or an object key in S3.
  storageKey    String
  version       Int       @default(1)
  uploadedById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  folder     MediaFolder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy User?               @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  variants   MediaVariant[]
  versions   MediaAssetVersion[]

  @@index([folderId])
  @@index([checksum])
  @@index([mimeType])
  @@index([deletedAt])
}

/// A generated derivative — the responsive `srcset` the public site is missing.
model MediaVariant {
  id         String @id @default(cuid())
  assetId    String
  label      String
  width      Int
  height     Int
  format     String
  size       Int
  storageKey String

  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, label, format])
  @@index([assetId])
}

/// Kept so "replace image" is reversible: the bytes of every superseded
/// version stay in storage until an admin prunes them.
model MediaAssetVersion {
  id         String   @id @default(cuid())
  assetId    String
  version    Int
  storageKey String
  size       Int
  mimeType   String
  note       String?
  createdAt  DateTime @default(now())

  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, version])
}

// =====================================================================
// Settings, audit, notifications
// =====================================================================

/// Global configuration, one row per key.
///
/// `secret` marks values that must never leave the server in a list response —
/// SMTP passwords, API keys. The service redacts them; the column exists so
/// that rule is data rather than a hand-maintained list in code.
model Setting {
  key         String   @id
  group       String
  value       Json
  description String?
  secret      Boolean  @default(false)
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([group])
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

/// Append-only. Nothing in the application updates or deletes these rows.
///
/// `actorEmail` is denormalised on purpose: the log has to stay readable after
/// the user record is gone, and a foreign key that has been set to null tells
/// you an action happened but not who did it.
model AuditLog {
  id            String       @id @default(cuid())
  actorId       String?
  actorEmail    String?
  action        String
  resource      String
  resourceId    String?
  before        Json?
  after         Json?
  ip            String?
  userAgent     String?
  outcome       AuditOutcome @default(SUCCESS)
  message       String?
  /// Ties every row one request produced together.
  ///
  /// A publish writes eight rows — entries, versions, a snapshot — and without
  /// this they are eight unrelated facts. Set from `AsyncLocalStorage`, so no
  /// service has to thread it through a call chain, and a background job
  /// inherits the id of the request that enqueued it.
  ///
  /// Nullable because every row written before this column existed has none,
  /// and backfilling a correlation that was never recorded would be inventing
  /// one.
  correlationId String?
  createdAt     DateTime     @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([resource, resourceId])
  @@index([action])
  @@index([correlationId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  title     String
  body      String?
  /// Where clicking it goes in the dashboard.
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// =====================================================================
// Site-facing records
// =====================================================================

enum ApplicationStatus {
  NEW
  IN_REVIEW
  INTERVIEW
  REJECTED
  HIRED
  WITHDRAWN
}

/// A dossier submitted through the site's application form.
///
/// The form already POSTs `multipart/form-data` with exactly these fields —
/// see `BewerbungDialog`. This is the receiving end it has been waiting for.
/// Personal data, so it carries its own retention date rather than living
/// forever by default.
model JobApplication {
  id            String            @id @default(cuid())
  openingId     String?
  position      String
  firstName     String
  lastName      String
  email         String
  phone         String?
  availableFrom String?
  message       String?
  /// `[{ filename, size, mimeType, storageKey, checksum }]`.
  files         Json              @default("[]")
  status        ApplicationStatus @default(NEW)
  note          String?
  ip            String?
  userAgent     String?
  /// When this record and its files are due for deletion.
  retainUntil   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([openingId])
  @@index([retainUntil])
}

/// How one person wants to see one list (foundation stage F11).
///
/// Server-side rather than `localStorage`, and that is the decision worth
/// recording: a column arrangement that lives in the browser is lost when the
/// person opens the dashboard on the machine in the meeting room, which is
/// exactly when they need the view they built. It follows the account.
///
/// One row per user per resource. Deleting it restores the default, which is
/// why "Standard wiederherstellen" is a DELETE and not a write of the defaults
/// — storing the defaults would freeze them at whatever they were that day.
model ListPreference {
  id       String @id @default(cuid())
  userId   String
  /// `application`, `project` — the resource key from `rbac/resources.ts`.
  resource String

  /// `{ hidden: string[], sort: { field, dir }, perPage: number }`.
  ///
  /// Json rather than columns because it is a *preference*: it has no
  /// invariants, nothing joins to it, and every list will want one more thing
  /// in it. A migration per column would be a migration per whim.
  view Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource])
}

model Redirect {
  id         String    @id @default(cuid())
  from       String    @unique
  to         String
  statusCode Int       @default(301)
  enabled    Boolean   @default(true)
  hits       Int       @default(0)
  lastHitAt  DateTime?
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([enabled])
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  /// Out of attempts. A human decides whether to retry it.
  DEAD
  CANCELLED
}

/// Background work (foundation stage F10, architecture §7.6).
///
/// A table rather than a queue server, and the trade is written down in the
/// architecture: one table plus a poller is ~200 lines, Redis is already a
/// documented dependency for the lock, and `enqueue()` is the seam that makes
/// moving to BullMQ a one-file change.
///
/// Four properties a request cannot provide and every one of these needs:
/// durable across a restart, retried with backoff, attributable to whoever
/// asked for it, and **visible** — "the export never arrived" has to have an
/// answer that is not a log file.
model Job {
  id      String    @id @default(cuid())
  /// The handler's name, from the registry in `core/jobs/catalogue.ts`.
  name    String
  payload Json      @default("{}")
  status  JobStatus @default(QUEUED)

  /// When it may first run. Later than now for a scheduled or retried job.
  runAfter    DateTime @default(now())
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)

  startedAt  DateTime?
  finishedAt DateTime?
  /// Milliseconds, so a job that got slower is visible before it times out.
  durationMs Int?
  error      String?
  /// The handler's own return value, for a job whose result is the point.
  result     Json?

  /// Inherited from the request that enqueued it, so the job's audit rows
  /// group with the click that caused them.
  correlationId String?
  /// Denormalised: the actor may be deleted before the job runs.
  actorId       String?
  actorEmail    String?

  /// Which worker has it. Set with the claim, so a stuck job names its holder.
  lockedBy String?
  lockedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The claim query: the oldest due job in each status.
  @@index([status, runAfter])
  @@index([name, status])
  @@index([correlationId])
}

// =====================================================================
// The operational domain — Wave 1
// =====================================================================
//
// Everything above this line is the CMS: content, media, users, the job
// queue. Everything below is the business the firm actually runs, and the
// two halves share only `User`.
//
// The premise, from `docs/system-audit.md` §0: there was no operational
// domain model at all. A Swiss engineering office plans, delivers and bills
// against *projects* — and a project is not a row with a name. It has a
// Bauherrschaft, an object, a responsible engineer, a set of Gewerke each
// with its own budget and lead, a team, and SIA phases it is contracted to
// deliver. Each of those is a table here because each is something the firm
// asks questions about.
//
// This is the Wave 1 slice (`docs/roadmap.md` §3). `Customer`, `Building`,
// `Employee` and `Discipline` are deliberately *minimal* — enough to create
// a real project against, no more. The full CRM comes back in Wave 3 and the
// full building model (floors, systems, rooms, loads) in Wave 2. What is
// here is not a stub with the fields guessed; it is the subset of the
// documented model that `Project` requires as data.

/// Shared across the domain. `URGENT` is deliberately above `HIGH` rather
/// than a separate flag: two parallel scales get used inconsistently.
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// SIA 112 phase codes, the vocabulary the firm already plans in.
///
/// An enum *and*, later, an entity — see `docs/data-model.md` §1.1. The enum
/// is the vocabulary (`P41` means Bauprojekt everywhere); `ProjectPhase`
/// (Wave 1 module 5) is the instance of one phase on one project, with its
/// dates, its fee and its sign-off. `Project.currentPhase` below holds the
/// vocabulary only, and says so.
enum SiaPhase {
  P31 // Vorprojekt
  P32 // Bauprojekt
  P33 // Bewilligungsverfahren
  P41 // Ausschreibung
  P51 // Ausführungsprojekt
  P52 // Ausführung
  P53 // Inbetriebnahme / Abschluss
}

// ---------------------------------------------------------------------
// The firm
// ---------------------------------------------------------------------

/// Thun and Bern. **Not tenancy** — see architecture §7.8: every office sees
/// every project, and `officeId` answers "who looks after this", not "who
/// may see it". Making it a tenant boundary later is a policy change, not a
/// schema one, which is the reason it is a nullable link rather than a
/// required scope on every query.
enum OrganisationStatus {
  ACTIVE
  DORMANT
  LIQUIDATION
}

/// The firm itself.
///
/// **Exactly one row, and its id is the literal `org`.** A singleton as a table
/// rather than as a settings group, because the alternative is what this model
/// replaced: nine key/value rows holding the company's name, legal name and
/// e-mail as untyped JSON, eight of which nothing read. A column can be typed,
/// indexed, validated and versioned; a JSON blob under a string key cannot.
///
/// The id is a constant rather than a cuid so that every read is
/// `findUnique({ where: { id: "org" } })` and every write an `upsert` on the
/// same — which makes the row self-healing. A `findFirst()` against a table that
/// should have one row is a query that silently starts returning the wrong one
/// the day a second appears.
///
/// **This is the source of truth for company identity.** `Office` below holds
/// the addresses, and the published website document derives its `offices` from
/// that table rather than from a parallel content type — see
/// `snapshot.builder.ts`. Anything the firm *says about itself* as editorial
/// copy stays in the CMS; anything it *is* lives here.
model Organisation {
  id String @id @default("org")

  // ---- General -----------------------------------------------------
  name             String             @default("IEM AG")
  shortName        String             @default("IEM")
  description      String?
  foundedYear      Int?
  organisationType String             @default("Aktiengesellschaft")
  defaultLocale    String             @default("de-CH")
  defaultTimezone  String             @default("Europe/Zurich")
  defaultCurrency  String             @default("CHF")
  status           OrganisationStatus @default(ACTIVE)

  // ---- Legal identity ----------------------------------------------
  /// Full registered name, where it differs from the trading name.
  legalName                  String?
  legalForm                  String?
  /// Swiss business identification number, `CHE-123.456.789`.
  uid                        String?
  /// The same number with the ` MWST` suffix when the firm is VAT-registered.
  vatId                      String?
  commercialRegister         String?
  registerOffice             String?
  legalStreet                String?
  legalZip                   String?
  legalCity                  String?
  legalCountry               String  @default("CH")
  /// Free text: an invoice address is frequently a department and a PO box
  /// rather than a second structured address, and forcing it into columns
  /// produces empty ones.
  invoiceAddress             String?
  legalContactName           String?
  legalContactEmail          String?
  /// The DSG/GDPR contact. Separate from the legal contact on purpose — at this
  /// size they are usually the same person, and the day they are not, the
  /// distinction is the one that matters.
  dataProtectionContactName  String?
  dataProtectionContactEmail String?
  copyright                  String?
  legalNotice                String?

  // ---- Contact -----------------------------------------------------
  mainEmail        String?
  mainPhone        String?
  recruitmentEmail String?
  supportEmail     String?
  billingEmail     String?
  website          String?

  // ---- Website defaults --------------------------------------------
  /// `{seite} — IEM AG`. Fallback only; the `seo` content type still owns the
  /// published title, and this fills in where it is blank.
  seoTitlePattern String?
  seoDescription  String?
  ogImageUrl      String?
  faviconUrl      String?

  /// The optimistic lock. Same mechanism as `Project.version`: the number goes
  /// into the `WHERE` of an `updateMany`, which is one statement and therefore
  /// actually a lock.
  version Int @default(1)

  updatedById String?
  updatedBy   User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A branch office.
///
/// Master data **and** website content, which is the whole point: `Employee`,
/// `Project` and `Building` point at a row here, and the published document's
/// `offices` array is built from the same rows. Before this they were two
/// unrelated stores and they had already drifted — the seed said Thun was at
/// Bierigutstrasse 6 while the live site said Uttigenstrasse 49.
///
/// `isPublic` is what lets the two coexist without a second table: a registered
/// office that nobody should visit is a real row that simply does not reach the
/// site.
model Office {
  id   String @id @default(cuid())
  name String
  /// Printed opposite the city on the site — "Hauptsitz", "Zweigbüro".
  kind String @default("Zweigbüro")

  street  String?
  zip     String?
  city    String?
  canton  String?
  country String  @default("CH")

  phone String?
  email String?

  latitude     Float?
  longitude    Float?
  mapsUrl      String?
  /// Free text, one line per day. A structured opening-hours model is a week of
  /// work for a firm whose two offices keep the same hours.
  openingHours String?

  /// Exactly one row should carry this; `organisation.rules.ts` enforces it.
  isHeadquarters Boolean @default(false)
  /// Whether the office appears on the public website.
  isPublic       Boolean @default(true)
  /// Explicit order on the site and in the register. The headquarters is not
  /// implicitly first: an office can be the registered seat and not the one a
  /// visitor should be shown first.
  position       Int     @default(0)

  /// Archived is not deleted. An office that has closed still has employees and
  /// projects pointing at it, and the history must keep resolving.
  archivedAt DateTime?

  version     Int     @default(1)
  updatedById String?
  updatedBy   User?   @relation("OfficeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  employees Employee[]
  projects  Project[]
  buildings Building[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@index([isPublic, position])
}

/// A self-referencing tree. The audit's fourth known gap was that no
/// Department entity existed and the closest thing was a hardcoded option
/// list on the team content type; this closes it.
model Department {
  id       String       @id @default(cuid())
  code     String       @unique
  name     String
  parentId String?
  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentTree")

  /// The head of department. `SetNull`, like every actor link: a departed
  /// employee must not cascade away the department.
  headId String?
  head   Employee? @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)

  employees Employee[] @relation("DepartmentMembers")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([parentId])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  APPRENTICE
  TEMPORARY
  CONTRACTOR
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  LEFT
}

/// The person.
///
/// Three things in this system look like "a person" and none of them is the
/// same thing: `User` is a **login**, `Employee` is a **person the firm
/// employs**, and the `team` content type is a **public portrait** on the
/// website. They have different lifecycles — an engineer exists before their
/// account and after it is revoked, and half the firm never appears on the
/// site. `userId` is the optional bridge, and it is nullable in both
/// directions on purpose.
model Employee {
  id              String  @id @default(cuid())
  personnelNumber String  @unique
  firstName       String
  lastName        String
  email           String  @unique
  phone           String?
  mobile          String?
  position        String?

  employmentType  EmploymentType @default(FULL_TIME)
  /// 1–100. A Pensum, not an FTE decimal — the firm writes "80%".
  workloadPercent Int            @default(100)
  /// Personal data. Readable only with `employee.compensation`, which is a
  /// permission separate from `employee.read`; the mapper drops it when the
  /// caller lacks it rather than the query omitting it, so there is one
  /// place to check.
  hourlyRate      Decimal?       @db.Decimal(12, 2)

  hireDate DateTime
  exitDate DateTime?
  status   EmployeeStatus @default(ACTIVE)

  departmentId String?
  department   Department? @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  officeId     String?
  office       Office?     @relation(fields: [officeId], references: [id], onDelete: SetNull)

  /// The line manager. Self-referencing; the service rejects a cycle,
  /// because the database cannot.
  managerId String?
  manager   Employee?  @relation("EmployeeLine", fields: [managerId], references: [id], onDelete: SetNull)
  reports   Employee[] @relation("EmployeeLine")

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  headOf               Department[]           @relation("DepartmentHead")
  disciplinesLed       Discipline[]           @relation("DisciplineManager")
  projectsManaged      Project[]              @relation("ProjectManager")
  memberships          ProjectMember[]
  projectDisciplines   ProjectDiscipline[]    @relation("ProjectDisciplineLead")
  customersOwned       Customer[]             @relation("CustomerOwner")
  tasksAssigned        Task[]                 @relation("TaskAssignee")
  meetingsOrganised    Meeting[]              @relation("MeetingOrganiser")
  meetingAttendance    MeetingAttendee[]      @relation("MeetingAttendee")
  meetingsPresented    MeetingAgendaItem[]    @relation("MeetingPresenter")
  meetingItemsOwned    MeetingItem[]          @relation("MeetingResponsible")
  meetingsApproved     MeetingApproval[]      @relation("MeetingApprover")
  decisionsTaken       Decision[]             @relation("DecisionDecidedBy")
  drawingsDrawn        Drawing[]              @relation("DrawingDrawnBy")
  drawingsChecked      Drawing[]              @relation("DrawingCheckedBy")
  drawingsApproved     Drawing[]              @relation("DrawingApprovedBy")
  revisionsDrawn       DrawingRevision[]      @relation("RevisionDrawnBy")
  revisionsChecked     DrawingRevision[]      @relation("RevisionCheckedBy")
  revisionsApproved    DrawingRevision[]      @relation("RevisionApprovedBy")
  transmittalsSent     Transmittal[]          @relation("TransmittalSentBy")
  transmittalsReceived TransmittalRecipient[] @relation("TransmittalRecipient")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, lastName])
  @@index([departmentId])
  @@index([officeId])
}

/// Master data for a Gewerk: Heizung, Lüftung, Sanitär, Elektro…
///
/// **Deliberately not an enum**, and it is the correction with the widest
/// consequences in the model (`docs/data-model.md` §3.4). A Gewerk has a
/// Fachbereichsleiter, a fee share, its own deliverables and its own budget.
/// An enum can hold none of that, and almost every later entity — drawings,
/// issues, time entries, budgets — is scoped by discipline.
model Discipline {
  id   String @id @default(cuid())
  code String @unique
  name String

  /// The Fachbereichsleiter — who owns this Gewerk across the firm. This is
  /// the difference between a lookup table and an org chart: *who do I ask
  /// about Lüftung* should be answerable without already knowing.
  managerId String?
  manager   Employee? @relation("DisciplineManager", fields: [managerId], references: [id], onDelete: SetNull)

  /// **A token name, not a hex literal.** The drawings, the Gantt, the
  /// Kanban and the 3D scene all resolve it, so a Lüftung run is the same
  /// colour everywhere — and a literal here would be the one colour in the
  /// system that cannot answer to dark mode.
  ///
  /// It is also a **closed set of six**: `disc-heat` `disc-air` `disc-water`
  /// `disc-power` `disc-energy` `disc-model`, declared in `admin.css` for both
  /// themes and checked for contrast by `theme.contrast.test.ts`. The same
  /// rule the public site's `src/content/schema.ts` already states, and for the
  /// same reason — a seventh name would resolve to nothing and render as a
  /// transparent dot rather than failing.
  defaultColour String @default("disc-model")

  /// The share of a typical fee this Gewerk carries, 0–1. What makes a new
  /// project's budget breakdown a proposal rather than an empty form.
  defaultBudgetShare Decimal? @db.Decimal(5, 4)
  defaultHourlyRate  Decimal? @db.Decimal(12, 2)

  order  Int     @default(0)
  active Boolean @default(true)

  projectDisciplines ProjectDiscipline[]
  tasks              Task[]
  meetingItems       MeetingItem[]
  decisions          Decision[]
  drawings           Drawing[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([active, order])
}

// ---------------------------------------------------------------------
// The commercial side, and the object
// ---------------------------------------------------------------------

enum CustomerType {
  COMPANY
  PUBLIC_BODY
  PRIVATE
}

enum CustomerStatus {
  LEAD
  ACTIVE
  DORMANT
  ARCHIVED
}

/// Company or private client. The Wave 1 slice: enough to be a
/// Bauherrschaft. The full CRM — contacts, activity history, offers — is
/// Wave 3 module 18.
model Customer {
  id        String         @id @default(cuid())
  number    String         @unique
  name      String
  legalName String?
  /// `CHE-###.###.###` when present.
  vatNumber String?
  type      CustomerType   @default(COMPANY)
  status    CustomerStatus @default(ACTIVE)

  address String?
  zip     String?
  city    String?
  country String  @default("CH")

  phone   String?
  email   String?
  website String?
  notes   String?

  /// The account manager.
  ownerId String?
  owner   Employee? @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  buildings           Building[]
  projects            Project[]  @relation("ProjectCustomer")
  projectsAsArchitect Project[]  @relation("ProjectArchitect")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, name])
}

enum BuildingUsage {
  WOHNBAU
  BUERO
  INDUSTRIE
  GEWERBE
  SCHULE
  SPITAL
  SPORT
  KULTUR
  LANDWIRTSCHAFT
  ANDERE
}

enum ConstructionType {
  NEUBAU
  UMBAU
  SANIERUNG
  ERWEITERUNG
}

enum EnergyStandard {
  MINERGIE
  MINERGIE_P
  MINERGIE_A
  GEAK_A
  GEAK_B
  GEAK_C
  GEAK_D
  GEAK_E
  GEAK_F
  GEAK_G
  KEINER
}

/// The physical object, and the thing the firm's work is actually about.
///
/// **It is its own entity, not an address field on the project**, and the
/// reason is the second commission: a building outlives any one project, and
/// the refurbishment ten years after the Neubau should inherit its areas,
/// its EGID and its systems. That inheritance is most of the value of having
/// this table at all.
///
/// Wave 1 slice: the core identity and the SIA 416 figures. Floors,
/// BuildingSystems, Rooms and RoomLoads are Wave 2 module 6.
model Building {
  id     String @id @default(cuid())
  number String @unique
  name   String

  /// The Bauherrschaft. Required — a building with no owner is a landmark.
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  address String?
  zip     String?
  city    String?
  country String  @default("CH")

  parcelNumber String?
  /// The federal building identifier, eight digits.
  egid         String?
  /// LV95 E/N.
  coordinates  Json?

  usage            BuildingUsage?
  constructionType ConstructionType?
  energyStandard   EnergyStandard?

  yearBuilt             Int?
  yearRenovated         Int?
  floorCount            Int?
  undergroundFloorCount Int?

  /// SIA 416: Energiebezugsfläche, Geschossfläche, Gebäudevolumen.
  heatedArea Decimal? @db.Decimal(12, 2)
  grossArea  Decimal? @db.Decimal(12, 2)
  volume     Decimal? @db.Decimal(12, 2)

  officeId String?
  office   Office? @relation(fields: [officeId], references: [id], onDelete: SetNull)

  projects Project[]
  drawings Drawing[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([customerId])
  @@index([city, name])
}

// ---------------------------------------------------------------------
// The project
// ---------------------------------------------------------------------

/// `PLANNED → ACTIVE → (ON_HOLD ↔ ACTIVE) → COMPLETED → ARCHIVED`, with
/// `CANCELLED` reachable from the three live states. The transitions are
/// enforced in `projects.rules.ts`, not here: Postgres can reject a typo but
/// not a sequence.
enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
  CANCELLED
}

/// Derived, never typed — see `Project.health`.
enum ProjectHealth {
  GREEN
  AMBER
  RED
}

/// The centre of the system.
model Project {
  id     String @id @default(cuid())
  /// `P-2026-014`. Allocated on create from the year and a per-year counter.
  number String @unique
  name   String

  status   ProjectStatus @default(PLANNED)
  priority Priority      @default(MEDIUM)

  /// **Derived and denormalised, for list filtering only.** The truth is the
  /// one `ProjectPhase` row that is `ACTIVE` (Wave 1 module 5). Kept here so
  /// "all projects in Ausführung" is an indexed scan rather than a join, and
  /// recomputed whenever a phase changes — never typed by a user.
  currentPhase SiaPhase?

  /// **Derived, stored for sorting.** Budget burn against progress against
  /// deadline proximity — `deriveHealth` in `projects.rules.ts` is the only
  /// writer. A stored number that should have been a computed one goes
  /// stale, which is the same discipline as the site's `{token}`
  /// placeholders, so both this and `progressPercent` are recomputed on
  /// write *and* reconciled nightly, and a test asserts the two agree.
  health          ProjectHealth @default(GREEN)
  /// 0–100, derived from milestone completion.
  progressPercent Int           @default(0)

  /// Required. An engineering project without a Bauherrschaft is not a
  /// project — no `onDelete`, so the database refuses to remove a customer
  /// that still has one.
  customerId String
  customer   Customer @relation("ProjectCustomer", fields: [customerId], references: [id])

  /// The architect is another company, hence a second link to `Customer`
  /// rather than a field. `SetNull` because a project survives the practice
  /// that designed it.
  architectId String?
  architect   Customer? @relation("ProjectArchitect", fields: [architectId], references: [id], onDelete: SetNull)

  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  /// The responsible engineer. Required *as data* — `ACTIVE` is refused
  /// without one — but `SetNull` at the database, because a manager leaving
  /// must not cascade away the project. The two rules are not in conflict:
  /// one is a lifecycle rule, the other is a referential one.
  managerId String?
  manager   Employee? @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  officeId String?
  office   Office? @relation(fields: [officeId], references: [id], onDelete: SetNull)

  startDate      DateTime?
  plannedEndDate DateTime?
  actualEndDate  DateTime?

  contractValue Decimal? @db.Decimal(12, 2)
  currency      String   @default("CHF")
  budgetHours   Int?

  description String?
  notes       String?

  members      ProjectMember[]
  disciplines  ProjectDiscipline[]
  milestones   Milestone[]
  tasks        Task[]
  meetings     Meeting[]
  decisions    Decision[]
  drawings     Drawing[]
  transmittals Transmittal[]

  /// The record's own revision — `P-2026-014 v12`.
  ///
  /// Two jobs in one column, and the second is why it is a column rather than a
  /// count of `EntityVersion` rows:
  ///
  /// 1. **What to show.** "v12" beside the number, and the history to match.
  /// 2. **Optimistic locking.** An update names the version it read, and the
  ///    write is `updateMany({ where: { id, version: expected } })` — which
  ///    matches no rows if somebody else saved first. Without it the second
  ///    save wins silently and the first person's work is gone with nothing
  ///    recording that it existed.
  ///
  /// Counting rows could answer the first and never the second: the check has
  /// to be in the same statement as the write, or it is a race with extra
  /// steps.
  version Int @default(1)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  archivedAt  DateTime?
  createdById String?
  updatedById String?

  /// The list contract's default sort and its three commonest filters.
  @@index([status, updatedAt])
  @@index([customerId])
  @@index([managerId])
  @@index([health, plannedEndDate])
}

/// How a record counts its own revisions — see `core/versioning/revision.ts`.
enum RevisionScheme {
  /// 1, 2, 3 … — Project, Meeting, Document, Offer.
  NUMERIC
  /// A, B, C … Z, AA — SIA/ISO drawing practice. Drawing, Transmittal.
  ALPHA
}

/// One recorded state of one business record.
///
/// **Fachliche Versionierung, not git** (foundation stage F13): the number a
/// person writes on a drawing, quotes in an e-mail and signs off against.
///
/// One table for every entity rather than a `ProjectVersion`, a
/// `DrawingVersion` and seventeen more. The trade is deliberate and worth
/// stating, because the other choice is defensible too:
///
/// * **What a shared table buys** — one place that knows how to record a
///   version, one place that knows how to read a history, and a module gets
///   versioning by calling a service rather than by writing a migration. At
///   nineteen modules that is nineteen tables and nineteen slightly different
///   history screens avoided.
/// * **What it costs** — no foreign key. `entityId` cannot reference twenty
///   tables at once, so a deleted record can leave versions behind. That is
///   *correct* here: everything is soft-deleted, and a version history that
///   vanished with the row would be a history of nothing. `AuditLog` makes
///   exactly the same trade for exactly the same reason.
///
/// The payload is the **whole record as the API returns it**, not a diff.
/// Diffs are cheap to store and expensive to read — reconstructing v7 means
/// replaying six of them and being right about all six — and the thing anybody
/// ever asks is "what did it look like then".
model EntityVersion {
  id String @id @default(cuid())

  /// `project`, `drawing`, `meeting`. The same vocabulary `AuditLog.resource`
  /// and `DomainEvent.entity` use, so the three can be joined by eye.
  entity   String
  entityId String

  /// 1-based, and dense per record. The unique below is what makes a
  /// concurrent write collide rather than produce two v7s.
  version Int
  scheme  RevisionScheme @default(NUMERIC)
  /// The rendered form — `v7`, `C`. Stored rather than derived so a history
  /// list needs no lookup table and an exported PDF cannot disagree with the
  /// screen.
  label   String

  /// The record as the API returned it at this version.
  data    Json
  /// Which fields the writer changed, for a history that reads as a sentence
  /// rather than as two JSON blobs side by side.
  changed String[]
  /// Why. Free text from the writer — a Baustopp, a client instruction.
  note    String?

  /// Denormalised, like the audit log's: the person may be deleted, and a
  /// history that says "unknown" about who signed off is not a history.
  changedById    String?
  changedByEmail String?
  changedByName  String?

  /// Ties this version to the request that produced it, and therefore to its
  /// audit rows and its events.
  correlationId String?

  createdAt DateTime @default(now())

  @@unique([entity, entityId, version])
  @@index([entity, entityId, createdAt])
  @@index([correlationId])
}

enum ProjectMemberRole {
  MANAGER
  ENGINEER
  DRAFTSMAN
  CONSULTANT
  APPRENTICE
}

/// Who is on the project, in what role, for what period.
///
/// The composite unique includes `from`, not just the pair: the same
/// engineer legitimately rejoins a project after a year on something else,
/// and a unique on `(projectId, employeeId)` would force that second stint
/// to overwrite the first and lose the history.
model ProjectMember {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  role              ProjectMemberRole @default(ENGINEER)
  /// The share of this person's Pensum planned on this project, 1–100.
  allocationPercent Int               @default(100)
  from              DateTime
  to                DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([projectId, employeeId, from])
  @@index([employeeId])
}

enum ProjectDisciplineStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  NOT_IN_SCOPE
}

/// The scope of one Gewerk on one project.
///
/// This is the table that lets the system answer what an engineering office
/// actually asks: *what is the Lüftung budget on Guglera and who owns it*,
/// *how many Sanitär hours are open across all projects*, *which projects
/// have no Elektro lead*. The enum the first draft used answers none of
/// them.
model ProjectDiscipline {
  id           String     @id @default(cuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  disciplineId String
  discipline   Discipline @relation(fields: [disciplineId], references: [id])

  leadEngineerId String?
  leadEngineer   Employee? @relation("ProjectDisciplineLead", fields: [leadEngineerId], references: [id], onDelete: SetNull)

  status ProjectDisciplineStatus @default(PLANNED)

  /// Percent of the project fee, 0–100. The sum across a project may exceed
  /// 100 only with `feeShareOverride` — subcontracted scope legitimately
  /// does, and refusing it outright would make the honest case impossible.
  feeShare         Decimal? @db.Decimal(5, 2)
  feeShareOverride Boolean  @default(false)

  budgetHours Int?
  budgetCost  Decimal? @db.Decimal(12, 2)
  /// Overrides `Discipline.defaultHourlyRate` for this project.
  hourlyRate  Decimal? @db.Decimal(12, 2)
  scopeNote   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([projectId, disciplineId])
  @@index([disciplineId, status])
}

enum MilestoneStatus {
  OPEN
  AT_RISK
  MET
  MISSED
  WAIVED
}

/// A dated commitment on a project. `progressPercent` is computed from these.
model Milestone {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name    String
  dueDate DateTime
  metAt   DateTime?
  status  MilestoneStatus @default(OPEN)
  phase   SiaPhase?

  /// What connects Planning to Finance: meeting such a milestone raises
  /// `MilestoneReached`, and Finance may create an invoice draft from it.
  isBillingTrigger Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tasks Task[]

  @@index([projectId, dueDate])
  @@index([status, dueDate])
}

// =====================================================================
// Aufgaben — Wave 2, module 1
//
// `docs/data-model.md` §3.9. The first module derived from the Projects
// reference rather than inventing its own shape, and the first one that is
// *embedded* in another module's screen: `/projekte/:id/aufgaben` is one of the
// eight tabs `features/projects/screens/tabs.ts` declares as a placeholder.
// =====================================================================

/// `TODO → IN_PROGRESS → IN_REVIEW → DONE`, plus `BLOCKED` and `CANCELLED`.
///
/// `BLOCKED` is a status rather than a flag, which is the choice worth
/// recording: a boolean beside the status produces four states that mean
/// "blocked and also in progress", and every list then has to decide which of
/// the two to show. It is reachable from the three active states and returns to
/// the one it came from — `tasks.rules.ts` keeps that in `blockedFrom`.
enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
  CANCELLED
}

/// The four standard precedence relations, as Planning's Gantt needs them.
///
/// `FS` is finish-to-start and is what everybody means by "depends on"; the
/// other three exist because a Bauprogramm uses them and a module that only
/// modelled `FS` would be re-migrated the day Planning arrives.
enum TaskDependencyType {
  FS
  SS
  FF
  SF
}

/// A piece of work. Usually on a project, occasionally not.
///
/// **`projectId` is nullable and that is the module's defining decision.** The
/// firm's own to-dos — chase an offer, renew a certificate, book the Bauführer
/// course — are tasks with no project, and forcing a project on them would mean
/// either a "Sonstiges" dummy project polluting every project list, or those
/// to-dos living outside the system in somebody's notebook. The consequence is
/// that row-level visibility cannot simply be "the project's scope": see
/// `tasks.scope.ts`, which is where the interesting half of this module is.
model Task {
  id String @id @default(cuid())

  title       String
  description String?

  status   TaskStatus @default(TODO)
  priority Priority   @default(MEDIUM)

  /// Where `BLOCKED` came from, so unblocking returns the task rather than
  /// dropping it back to `TODO`. Null unless `status` is `BLOCKED`.
  blockedFrom   TaskStatus?
  /// Why it is blocked. Free text, and the reason a blocked board column is
  /// readable at all.
  blockedReason String?

  startDate   DateTime?
  dueDate     DateTime?
  /// Stamped by the transition to `DONE`, never typed. Same rule as
  /// `Project.actualEndDate`: "when was this finished" is not a field somebody
  /// should have to remember to fill in.
  completedAt DateTime?

  /// Hours, not money — two decimals because a quarter of an hour is 0.25 and
  /// the firm books in quarters.
  estimateHours Decimal? @db.Decimal(7, 2)

  /// **Derived, and nothing writes it yet.** Its input is `TimeEntry`, which is
  /// Wave 2 module 14. It is declared now because `docs/data-model.md` §3.9
  /// lists it and because the column is what module 14 will fill; it is
  /// deliberately *not* seeded and no rule reads it, so a reconciler that has
  /// stopped working cannot hide behind a plausible number. The same discipline
  /// `Project.progressPercent` states, applied to a figure that has no writer
  /// at all yet.
  spentHours Decimal @default(0) @db.Decimal(9, 2)

  /// Kanban order within one column. **Sparse and gap-based** — see
  /// `positionBetween` in `tasks.rules.ts`. Dropping a card between two others
  /// rewrites one row, not the column, which is what makes a board with two
  /// hundred cards usable.
  position Int @default(0)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// What the task delivers against. `SetNull`, because a milestone being
  /// rescheduled away must not take the work with it.
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  /// Unassigned is a real and common state — a task lands in the backlog before
  /// anybody owns it, and requiring an assignee at creation is how backlogs end
  /// up assigned to whoever wrote them.
  assigneeId String?
  assignee   Employee? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// One level of nesting in practice, not enforced in the schema. The rule
  /// that a parent cannot be `DONE` while a child is open is in
  /// `tasks.rules.ts`, and cycle detection with it — a self-referencing tree is
  /// something the database cannot refuse.
  parentTaskId String?
  parentTask   Task?   @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]  @relation("TaskSubtasks")

  /// Which Gewerk the work belongs to. Optional, because a firm-level task has
  /// none — but present, because "alle offenen Lüftungs-Aufgaben" is a question
  /// the firm asks weekly and a join through the project cannot answer it.
  disciplineId String?
  discipline   Discipline? @relation(fields: [disciplineId], references: [id], onDelete: SetNull)

  createdById String?
  updatedById String?

  /// Set when `TaskOverdue` was raised for the current `dueDate`, and cleared
  /// when the date moves. Without it the nightly job re-announces the same
  /// overdue task every night, and a notification that arrives every night is a
  /// notification nobody reads.
  overdueNotifiedAt DateTime?

  dependsOn    TaskDependency[] @relation("TaskSuccessor")
  blocks       TaskDependency[] @relation("TaskPredecessor")
  checklist    ChecklistItem[]
  /// The protocol lines that created this task. Usually none or one; a task
  /// re-raised at a later Bausitzung legitimately has two.
  meetingItems MeetingItem[]

  /// The record's own revision — the same optimistic lock `Project` documents.
  version Int @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// The board: one column of one project, in order.
  @@index([projectId, status, position])
  /// "Was liegt bei mir" — the single most-run query in the module.
  @@index([assigneeId, status, dueDate])
  /// The nightly overdue sweep, and the overdue filter on every list.
  @@index([dueDate, status])
  @@index([parentTaskId])
  @@index([milestoneId])
}

/// One precedence relation between two tasks.
///
/// A table rather than a self-relation on `Task`, because a dependency carries
/// its own data — the type and the lag — and because a task legitimately has
/// several. The unique on the pair is what stops a double-click creating the
/// same edge twice; the *cycle* rule cannot be a constraint and is in
/// `tasks.rules.ts`.
model TaskDependency {
  id String @id @default(cuid())

  /// The one that has to happen first.
  predecessorId String
  predecessor   Task   @relation("TaskPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  /// The one that waits.
  successorId   String
  successor     Task   @relation("TaskSuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  type    TaskDependencyType @default(FS)
  /// Days between the two ends of the relation. Negative is legitimate: a lag
  /// of −2 on `FS` means the successor may start two days before the
  /// predecessor finishes, which is how a Bauprogramm overlaps trades.
  lagDays Int                @default(0)

  createdAt DateTime @default(now())

  @@unique([predecessorId, successorId])
  @@index([successorId])
}

/// A line on a task's checklist.
///
/// Deliberately **not** a subtask. A checklist item has no assignee, no date and
/// no status machine — it is a tick — and modelling it as a `Task` would put
/// three hundred one-line rows on every board and in every "what is assigned to
/// me" query. The distinction is the same one `docs/data-model.md` draws between
/// a Task and an Issue: they differ in what can be asked of them.
model ChecklistItem {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  text     String
  done     Boolean   @default(false)
  doneAt   DateTime?
  /// The `Employee`, not the `User` — the same key every other "who did this"
  /// in the domain uses, so a checklist can be read beside a time sheet.
  doneById String?

  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, position])
}

/// A comment on any record.
///
/// **One table for every entity**, the same trade `AuditLog` and `EntityVersion`
/// make and for the same reasons:
///
/// * **What it buys** — one place that knows how to write a comment, one
///   thread component, and a module gets discussion by calling a service. At
///   nineteen modules the alternative is nineteen tables and nineteen slightly
///   different thread screens.
/// * **What it costs** — no foreign key, so a comment can outlive its record.
///   That is correct here: everything is soft-deleted, and a discussion that
///   vanished with the row would be a discussion of nothing.
///
/// `entity` uses the same vocabulary as `AuditLog.resource` and
/// `DomainEvent.entity`, so the three can be joined by eye.
model Comment {
  id String @id @default(cuid())

  entity   String
  entityId String

  body String

  /// Denormalised like the audit log's, and for the same reason: the account
  /// may be deleted, and a thread that says "unknown" about who raised the
  /// question is not a thread.
  authorId    String?
  authorEmail String?
  authorName  String?

  /// One level of replies. `SetNull` rather than cascade — deleting a question
  /// must not silently remove the answer somebody else wrote.
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies  Comment[] @relation("CommentReplies")

  /// Who was named with `@`. Ids, resolved by the reader — a stored display
  /// name would go stale the day somebody marries.
  mentionedIds String[]

  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([entity, entityId, createdAt])
  @@index([authorId])
}

// =====================================================================
// Sitzungen und Entscheide — Wave 2, module 2
//
// `docs/data-model.md` §3.11. **Not a calendar entry with a text field.** A
// Bausitzung is where this firm's decisions are taken, and the module exists to
// answer two questions a meeting list cannot:
//
//   > Wann wurde beschlossen, die Lüftung umzubauen — und von wem?
//   > Welche Pendenzen aus Bausitzung 12 sind heute noch offen?
//
// The first is why `Decision` is its own table rather than a `kind` on a
// protocol line; the second is why a `PENDENZ` line carries a `taskId` into the
// module built before this one.
// =====================================================================

enum MeetingType {
  KICKOFF
  BAUSITZUNG
  ABNAHME
  INTERN
  KUNDE
}

/// `PLANNED → HELD → (approved at the next one)`, plus `CANCELLED`.
///
/// There is no `MINUTED` state, and that is deliberate: minutes are not a
/// status of the meeting, they are its `MeetingItem` rows. A meeting with no
/// items is `HELD` and empty, which is a true and visible thing — a separate
/// status would let a meeting be "minuted" while the protocol was blank.
enum MeetingStatus {
  PLANNED
  HELD
  CANCELLED
}

/// The three kinds of line a protocol has, and they are not interchangeable.
///
/// `INFORMATION` is a note. `ENTSCHEID` points at a `Decision`, which outlives
/// the meeting. `PENDENZ` points at a `Task`, which is work somebody owes.
/// Collapsing them into a text column is what makes minutes a document nobody
/// reads: none of the three can then be searched, assigned or closed.
enum MeetingItemKind {
  INFORMATION
  ENTSCHEID
  PENDENZ
}

/// Minutes of a Bausitzung are approved at the *next* one, and an amendment is
/// a fact about the record rather than an edit to it.
enum MeetingApprovalDecision {
  APPROVED
  AMENDED
}

enum DecisionType {
  TECHNISCH
  KOMMERZIELL
  TERMIN
  GESTALTUNG
  ORGANISATORISCH
}

/// **`OFFEN` is a decision that has been asked for and not yet taken**, which
/// is a state a Bausitzung produces constantly and which a `decided` boolean
/// cannot represent. `AUFGEHOBEN` requires the decision that replaces it to
/// name this one: a reversal names its successor or it is not a reversal.
enum DecisionStatus {
  OFFEN
  ENTSCHIEDEN
  UMGESETZT
  AUFGEHOBEN
}

enum DecisionImpact {
  KOSTEN
  TERMIN
  QUALITAET
  KEINE
}

/// One meeting.
///
/// `projectId` is nullable for the same reason `Task.projectId` is — an
/// internal Geschäftsleitungssitzung is a meeting with minutes and no project —
/// and `meetings.scope.ts` therefore inherits the three-way reachability rule
/// rather than the project one.
model Meeting {
  id String @id @default(cuid())

  title    String
  type     MeetingType   @default(BAUSITZUNG)
  status   MeetingStatus @default(PLANNED)
  location String?

  /// **The number said out loud on site.** "Bausitzung 14" is how a meeting is
  /// referred to, and `14.3` is how one of its lines is — so the item's display
  /// key is derived from this and its `order` rather than stored. Null for a
  /// meeting that is not part of a series (a Kickoff, an Abnahme).
  seriesNumber Int?

  startsAt DateTime
  endsAt   DateTime?

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Who called it and owns the protocol. Required as data — a meeting nobody
  /// owns is a meeting whose minutes nobody writes — but `SetNull` at the
  /// database, because a person leaving must not cascade away the record.
  organiserId String?
  organiser   Employee? @relation("MeetingOrganiser", fields: [organiserId], references: [id], onDelete: SetNull)

  /// When the minutes went out. Stamped by the act, never typed — the same
  /// rule as `Project.actualEndDate` and `Task.completedAt`.
  minutesSentAt DateTime?

  /// The record's own revision. Minutes are edited by several people in the
  /// days after a meeting, which is precisely the case the optimistic lock
  /// exists for.
  version Int @default(1)

  attendees MeetingAttendee[]
  agenda    MeetingAgendaItem[]
  items     MeetingItem[]
  approvals MeetingApproval[]
  decisions Decision[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  @@index([projectId, startsAt])
  @@index([status, startsAt])
  @@index([type, seriesNumber])
}

/// Who was in the room, and who should have been.
///
/// **`attended` is nullable on purpose**: `null` is "not recorded yet", `false`
/// is "invited and did not come". Those are different facts, and a boolean that
/// defaulted to `false` would put everybody in the second column the moment the
/// meeting was created.
model MeetingAttendee {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  employeeId String?
  employee   Employee? @relation("MeetingAttendee", fields: [employeeId], references: [id], onDelete: SetNull)

  /// The external attendee, as free text.
  ///
  /// `docs/data-model.md` §3.11 says "exactly one of `employeeId` /
  /// `contactId`", and there is **no `Contact` table yet** — the CRM is Wave 3
  /// and the Wave 1 customer slice has no contacts. A Bauherr and an architect
  /// are in the room at every Bausitzung and have to be minutable today, so
  /// they are recorded by name and organisation. When `Contact` lands these two
  /// columns become a nullable FK and a migration reads them across; until then
  /// a name in a protocol is better than an attendee who cannot be recorded.
  externalName String?
  externalOrg  String?

  /// Whether their presence was expected. Drives "wer fehlte" on the protocol.
  required   Boolean   @default(true)
  invitedAt  DateTime?
  attended   Boolean?
  /// Sent apologies. Distinct from `attended: false`, which is simply absent.
  apologised Boolean   @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([meetingId])
  @@index([employeeId])
}

/// A traktandum, set *before* the meeting.
///
/// Separate from `MeetingItem`, which is written during or after it. The
/// agenda is what was planned and the protocol is what happened, and the two
/// disagree constantly — a traktandum that was not reached has no protocol
/// line, and half the useful lines belong to no traktandum at all.
model MeetingAgendaItem {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  /// 1-based, dense. The protocol's display key is the meeting's series number
  /// and the *item's* order, so this one only sequences the agenda.
  order Int

  title           String
  note            String?
  durationMinutes Int?

  presenterId String?
  presenter   Employee? @relation("MeetingPresenter", fields: [presenterId], references: [id], onDelete: SetNull)

  items MeetingItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([meetingId, order])
  @@index([meetingId, order])
}

/// One line of the protocol — **the module's centre of gravity**.
///
/// `14.3` is how it is cited out loud, and the key is derived from the
/// meeting's `seriesNumber` and this `order` rather than stored, because a
/// stored key goes wrong the first time a line is inserted.
///
/// A `PENDENZ` carries a `taskId` and an `ENTSCHEID` a `decisionId`. Both links
/// are what stop minutes being a document nobody reads: the Pendenz appears on
/// somebody's board, and the Entscheid can be cited two years later.
model MeetingItem {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  /// The traktandum it was discussed under, when there was one.
  agendaItemId String?
  agendaItem   MeetingAgendaItem? @relation(fields: [agendaItemId], references: [id], onDelete: SetNull)

  order Int
  text  String
  kind  MeetingItemKind @default(INFORMATION)

  /// The work this line created. `SetNull`, because deleting a task must not
  /// remove the line that says it was agreed — the protocol is the record.
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  /// The decision this line records. One decision per line; a line that
  /// records two is two lines.
  decisionId String?   @unique
  decision   Decision? @relation("DecisionItem", fields: [decisionId], references: [id], onDelete: SetNull)

  /// Who owes it, and by when — copied onto the `Task` when one is created and
  /// kept here because the protocol has to be readable without following the
  /// link.
  responsibleId String?
  responsible   Employee? @relation("MeetingResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  dueDate       DateTime?

  /// What Gewerk it concerns. This is what makes "alle offenen Pendenzen für
  /// Lüftung über alle Bausitzungen" a query rather than a re-read of twelve
  /// protocols.
  disciplineId String?
  discipline   Discipline? @relation(fields: [disciplineId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([meetingId, order])
  @@index([meetingId, order])
  @@index([kind, disciplineId])
  @@index([taskId])
}

/// The approval of a protocol, recorded at the *next* meeting.
///
/// A row rather than a pair of columns on `Meeting`, because minutes can be
/// approved with an amendment and then approved again — and because who
/// approved them is the question a dispute turns on.
model MeetingApproval {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  decision MeetingApprovalDecision
  /// Required for `AMENDED`, refused as empty by the service: an amendment
  /// nobody described is an amendment nobody can act on.
  note     String?

  decidedById String?
  decidedBy   Employee? @relation("MeetingApprover", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime  @default(now())

  createdAt DateTime @default(now())

  @@index([meetingId, decidedAt])
}

/// An Entscheid — **a fact about what was agreed, and it outlives its meeting**.
///
/// `docs/data-model.md` §3.11 argues the case: a decision is referenced by
/// later minutes, it is the reason a drawing changed, it gets superseded two
/// months on, and in a dispute it is the thing that gets looked up. A line
/// inside a protocol row cannot be cited, linked to, filtered or reversed.
///
/// Decisions and Tasks are different things and a meeting produces both: a
/// decision is what was agreed, a task is work somebody owes. A decision may
/// spawn tasks; it is not one.
model Decision {
  id String @id @default(cuid())

  /// `E-2026-017`, unique per project. Allocated like a project number: from
  /// the maximum already issued, never from a count, because a deleted
  /// decision still consumed its number and it is quoted in e-mails.
  number String

  title     String
  /// **Required.** The record exists to answer *why*, and a decision without a
  /// reason is the row nobody can act on two years later. Same principle as
  /// `DrawingRevision.changeNote`.
  rationale String

  /// Required: a decision is always about a project. No `onDelete`, so the
  /// database refuses to remove a project that still has one.
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  /// Where it was taken. Nullable because a decision taken on site is still a
  /// decision — `decidedAt` may predate any minutes.
  meetingId String?
  meeting   Meeting?     @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  /// The protocol line that records it, from the other side of the `@unique`.
  item      MeetingItem? @relation("DecisionItem")

  type   DecisionType   @default(TECHNISCH)
  status DecisionStatus @default(ENTSCHIEDEN)

  decidedAt         DateTime
  decidedById       String?
  decidedBy         Employee? @relation("DecisionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  /// When the Bauherrschaft decided it, as free text — see the note on
  /// `MeetingAttendee.externalName`. Becomes a `Contact` FK in Wave 3.
  decidedByExternal String?

  disciplineId String?
  discipline   Discipline? @relation(fields: [disciplineId], references: [id], onDelete: SetNull)

  impact             DecisionImpact @default(KEINE)
  /// Filled when known. A decision with `impact: KOSTEN` and no figure is a
  /// decision somebody still has to price, which is itself worth seeing.
  costImpact         Decimal?       @db.Decimal(12, 2)
  scheduleImpactDays Int?

  /// The decision this one reverses or replaces.
  ///
  /// The arrow points **from the new one to the old one**, so a reversal names
  /// its successor rather than the other way round — which is what lets
  /// `AUFGEHOBEN` be verifiable: a decision may only be set `AUFGEHOBEN` by the
  /// one superseding it. Must not cycle and must stay inside the project; both
  /// are rules the database cannot express and `meetings.rules.ts` can.
  supersedesId String?   @unique
  supersedes   Decision? @relation("DecisionSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy Decision? @relation("DecisionSupersedes")

  version Int @default(1)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  @@unique([projectId, number])
  @@index([projectId, decidedAt])
  @@index([status, decidedAt])
  @@index([disciplineId])
  @@index([meetingId])
}

/**
 * ====================================================================
 */
/**
 * Pläne — Wave 2, module 3
 */
/**
 * ====================================================================
 */

/// What a plan *is*, and it is deliberately not a Document.
///
/// Three things separate them and all three are lost by collapsing the two:
/// a plan carries a revision **letter** rather than a version number, it is
/// *issued* to named recipients on a date, and which revision somebody
/// received is a liability question. `docs/data-model.md` §3.13.
model Drawing {
  id String @id @default(cuid())

  /// The plan number, e.g. `4723-HZG-EG-101`. Unique within its project, like
  /// a decision's number and for the same reason: it is quoted in e-mails and
  /// printed in a title block, so it may never be reissued.
  number String
  title  String

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  /// Required. A plan without a Gewerk cannot answer "alle Lüftungspläne",
  /// which is the question the anchors exist for.
  disciplineId String
  discipline   Discipline @relation(fields: [disciplineId], references: [id])

  /// What it depicts. Nullable because a Prinzipschema often depicts no single
  /// building. `floorId`, `buildingSystemId` and the `DrawingRoom` join wait
  /// for Wave 2 module 6 — see the note in CLAUDE.md.
  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  type   DrawingType
  scale  String?
  format DrawingFormat @default(A3)
  phase  SiaPhase?

  status DrawingStatus @default(WIP)

  /// The letter or number of the newest revision, `null` before the first one.
  /// Denormalised so a list can show and sort by it without a join; written by
  /// exactly one method, like `Project.progressPercent`.
  currentRevision String?

  /// The newest revision that has actually **left the building**, `null` until
  /// the first Planversand. Not a duplicate of `currentRevision` but the other
  /// half of the question: that one is what the office is drawing, this one is
  /// what the Bauherr and the Unternehmer are holding, and they are the same
  /// letter only between a send and the next revision.
  ///
  /// Without it the row loses the fact entirely — a plan issued at `C` and then
  /// revised reads `currentRevision: "D"`, `status: WIP`, and nothing says `C`
  /// is on a building site. The fact survived only in the `Transmittal`, so
  /// *"welche Revision ist draussen"* meant querying the sends and *"welche
  /// Pläne müssen neu ausgegeben werden"* could not be a list query at all.
  ///
  /// Stored rather than derived because the register sorts and filters on it —
  /// the same justification `Project.progressPercent` has and the one
  /// `Task.isOverdue` failed. It needs no nightly reconciler, which is where it
  /// parts company with `progressPercent`: that one drifts because two of its
  /// inputs are the current date, whereas this one's inputs are append-only.
  /// A Transmittal cannot be edited or deleted, so nothing can change behind it.
  issuedRevision String?

  /// Gezeichnet / geprüft / freigegeben — three different people's authority in
  /// an engineering office, which is why they are three columns and four
  /// permissions rather than one `approvedById`.
  drawnById    String?
  drawnBy      Employee? @relation("DrawingDrawnBy", fields: [drawnById], references: [id], onDelete: SetNull)
  checkedById  String?
  checkedBy    Employee? @relation("DrawingCheckedBy", fields: [checkedById], references: [id], onDelete: SetNull)
  approvedById String?
  approvedBy   Employee? @relation("DrawingApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  version Int @default(1)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  revisions DrawingRevision[]

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([disciplineId])
  @@index([buildingId])
  @@index([status, updatedAt])
}

/// One issued state of a plan. **Append-only** — the bytes of every revision
/// survive, exactly as `MediaAssetVersion` does, because "which revision did
/// the Sanitär contractor have on 14 March" has to be answerable with the file.
model DrawingRevision {
  id String @id @default(cuid())

  drawingId String
  drawing   Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  /// `A`, `B`, … from `core/versioning/revision.ts` in its ALPHA scheme, which
  /// is bijective base-26 and therefore has no zero digit: after `Z` comes
  /// `AA`. A naive `String.fromCharCode(65 + n)` puts `[` in a title block.
  revision String

  /// **Required.** What changed is the whole point of a revision; a revision
  /// with an empty note is the row nobody can act on. Same principle as
  /// `Decision.rationale`.
  changeNote String
  reason     RevisionReason @default(ERSTAUSGABE)

  storageKey String
  fileName   String
  size       Int
  checksum   String
  mimeType   String

  drawnById    String?
  drawnBy      Employee? @relation("RevisionDrawnBy", fields: [drawnById], references: [id], onDelete: SetNull)
  checkedById  String?
  checkedBy    Employee? @relation("RevisionCheckedBy", fields: [checkedById], references: [id], onDelete: SetNull)
  approvedById String?
  approvedBy   Employee? @relation("RevisionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  /// Stamped by the acts, never typed — the same argument as
  /// `Meeting.minutesSentAt`.
  releasedAt   DateTime?
  supersededAt DateTime?

  createdAt   DateTime @default(now())
  createdById String?

  items TransmittalItem[]

  @@unique([drawingId, revision])
  @@index([drawingId, createdAt])
  @@index([releasedAt])
}

/// Planversand — the entity that makes the liability question answerable.
///
/// **Never updated and never deleted**, which is why it carries no `version`
/// and no `deletedAt`. A transmittal is a statement about the past; correcting
/// one means issuing another, the same reason `AuditLog` has no edit route.
model Transmittal {
  id     String @id @default(cuid())
  number String @unique

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  sentAt   DateTime
  sentById String?
  sentBy   Employee? @relation("TransmittalSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  purpose TransmittalPurpose @default(ZUR_INFORMATION)
  medium  TransmittalMedium  @default(EMAIL)
  note    String?

  createdAt   DateTime @default(now())
  createdById String?

  items      TransmittalItem[]
  recipients TransmittalRecipient[]

  @@index([projectId, sentAt])
}

model TransmittalItem {
  id String @id @default(cuid())

  transmittalId String
  transmittal   Transmittal @relation(fields: [transmittalId], references: [id], onDelete: Cascade)

  drawingRevisionId String
  drawingRevision   DrawingRevision @relation(fields: [drawingRevisionId], references: [id])

  copies Int            @default(1)
  format DrawingFormat?

  @@unique([transmittalId, drawingRevisionId])
  @@index([drawingRevisionId])
}

/// Who received it. `externalName` rather than a `contactId` because there is
/// no `Contact` table until Wave 3 — the same compromise `MeetingAttendee`
/// makes, and for the same reason: the Unternehmer receiving the plan is not a
/// user of this system and a Planversand without them in the list is not one.
model TransmittalRecipient {
  id String @id @default(cuid())

  transmittalId String
  transmittal   Transmittal @relation(fields: [transmittalId], references: [id], onDelete: Cascade)

  employeeId String?
  employee   Employee? @relation("TransmittalRecipient", fields: [employeeId], references: [id], onDelete: SetNull)

  externalName String?
  externalOrg  String?
  externalMail String?

  role RecipientRole @default(TO)

  /// Set when the recipient confirms. Null is "not confirmed", which is not
  /// "did not receive" — the same three-state distinction as
  /// `MeetingAttendee.attended`.
  acknowledgedAt DateTime?

  @@index([transmittalId])
}

enum DrawingType {
  GRUNDRISS
  SCHNITT
  ANSICHT
  SCHEMA
  PRINZIPSCHEMA
  DETAIL
  STRANGSCHEMA
  ISOMETRIE
}

enum DrawingFormat {
  A0
  A1
  A2
  A3
  A4
  SONDER
}

/// `RELEASED` is internal, `ISSUED` is external, and a single `APPROVED` state
/// cannot hold both: a released plan is approved in-house, an issued one has
/// left the building and somebody is building from it.
enum DrawingStatus {
  WIP
  IN_CHECK
  CHECKED
  RELEASED
  ISSUED
  SUPERSEDED
  WITHDRAWN
}

enum RevisionReason {
  ERSTAUSGABE
  KUNDENWUNSCH
  KOORDINATION
  FEHLERKORREKTUR
  BEHOERDE
  AUSFUEHRUNG
}

enum TransmittalPurpose {
  ZUR_INFORMATION
  ZUR_PRUEFUNG
  ZUR_AUSFUEHRUNG
  ZUR_FREIGABE
}

enum TransmittalMedium {
  EMAIL
  POST
  PLATTFORM
  UEBERGABE
}

enum RecipientRole {
  TO
  CC
}
