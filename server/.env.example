# IEM CMS — server configuration
#
# Copy to `.env` and fill in. Nothing here has a safe default that works in
# production: the two secrets must be generated per install, and the database
# URL is specific to wherever Postgres runs.

# ---- Database ------------------------------------------------------
# Postgres 14 or newer.
#
# Via Docker:
#   docker run --name iem-pg -e POSTGRES_PASSWORD=iem -e POSTGRES_DB=iem_cms \
#     -p 5432:5432 -d postgres:16
#
# Against an existing local install, check the port first — a Windows
# PostgreSQL installed alongside another one commonly lands on 5433, not 5432:
#   Get-NetTCPConnection -State Listen |
#     Where-Object { $_.OwningProcess -in (Get-Process postgres).Id } |
#     Select-Object LocalPort -Unique
#
# Then create the database once:
#   & "C:\Program Files\PostgreSQL\18\bin\psql.exe" -U postgres -h 127.0.0.1 `
#       -p 5433 -c "CREATE DATABASE iem_cms;"
DATABASE_URL="postgresql://postgres:PASSWORD@127.0.0.1:5432/iem_cms?schema=public"

# ---- Tokens --------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing JWT_ACCESS_SECRET signs everyone out, which is the intended way to
# revoke every session at once.
JWT_ACCESS_SECRET="CHANGE-ME-generate-48-random-bytes"
JWT_ACCESS_TTL="15m"
REFRESH_TTL_DAYS="30"

# ---- Second factor -------------------------------------------------
# Encrypts the TOTP secrets at rest (AES-256-GCM). 32 bytes, as base64 or as
# 64 hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# DELIBERATELY SEPARATE FROM JWT_ACCESS_SECRET. Rotating that one is the
# documented way to sign everybody out; if the two were derived from each
# other, doing the ordinary thing would silently destroy every enrolled
# authenticator.
#
# Leave it EMPTY and the application still starts — everything else works and
# MFA answers 503 with a message naming this variable. That is the right
# direction for a deployment that does not use it.
#
# LOSING IT is not recoverable by re-generating: the stored secrets can no
# longer be read, so enrolled users cannot complete a sign-in with their app.
# Their RECOVERY CODES still work (those are hashed, not encrypted), and
# anyone holding `user.resetMfa` can clear a credential. Back it up with the
# database, not in it.
MFA_ENCRYPTION_KEY=""

# Everything else the application stores and must read back in the clear: the
# SMTP password today, provider API keys and webhook signing secrets next.
# 32 bytes, base64 or hex — same generator as above.
#
# DELIBERATELY A SEPARATE KEY from MFA_ENCRYPTION_KEY, although both go through
# one AES-256-GCM implementation. The two hold values with different recovery
# stories: losing this one costs a password somebody retypes, losing that one
# de-enrols every second factor in the firm. Sharing a key would tie those
# consequences together, so that rotating it after an integration credential
# leaked would also sign out and de-enrol everybody.
#
# Without it the application boots, and every secret setting reads as "not
# configured" with a loud line in the boot log naming this variable. Nothing is
# silently treated as empty.
APP_SECRETS_ENCRYPTION_KEY=""

# ---- HTTP ----------------------------------------------------------
# 3100, not 3000, on purpose: 3000 is the default for Next.js, Rails and
# create-react-app, so on a machine with any other project running it is
# usually taken. Check before changing it:
#   Get-NetTCPConnection -State Listen -LocalPort 3100
PORT="3100"
NODE_ENV="development"

# Comma-separated. Must include the public site's origin — it fetches the
# published snapshot from here — and the dashboard's. No wildcard: the refresh
# cookie needs credentialed CORS, which forbids one.
CORS_ORIGINS="http://localhost:5173"

# Where the dashboard lives, for the links in invitation and reset mails.
ADMIN_URL="http://localhost:5173/admin.html"

# How many reverse proxies sit in front of this process, or which addresses to
# trust. Leave EMPTY when nothing proxies it — that is the safe default, and it
# makes the API ignore `X-Forwarded-For` entirely.
#
# It matters because any client can send that header. Believing it without a
# proxy means the IP recorded against every failed sign-in and every replayed
# session token is chosen by whoever is being logged, which is exactly the row
# the audit log is read for afterwards.
#
# Takes what Express takes: a hop count ("1" behind one nginx/Traefik), a
# comma-separated list of addresses or CIDR ranges, or `loopback`.
TRUST_PROXY=""

# ---- Media ---------------------------------------------------------
# Where uploaded bytes go. Job-application dossiers land under
# `bewerbungen/` inside this root and are deliberately NOT served statically —
# they are only reachable through the permission-checked download route.
MEDIA_ROOT="./var/media"
MEDIA_PUBLIC_PATH="/media"

# ---- Mail ----------------------------------------------------------
# Leave SMTP_HOST empty and every message is written to the process log
# instead of sent. That is the right behaviour for development — and it means
# a password-reset token is still recoverable from the log.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="noreply@iem.ch"
MAIL_FROM_NAME="IEM AG"

# ---- Seed ----------------------------------------------------------
# Read once, by `npm run seed`.
#
# Leave SEED_ADMIN_PASSWORD empty for anything that is not a throwaway local
# database: the account is then created without a password and activated
# through the reset flow, so no credential is ever written to a file.
SEED_ADMIN_EMAIL="admin@iem.ch"
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_PASSWORD=""

# --- e2e only -------------------------------------------------------
# Eight accounts: one per operational role (pl@ ing@ gl@ fin@ hr@ gast@ and
# adm@iem.test) for `e2e/security.spec.ts`, plus mfa@iem.test, which exists
# only so `e2e/mfa.spec.ts` can enable and disable a real second factor
# without touching an account another spec signs in with.
# The suite asserts a full role x verb x resource
# matrix and cannot say anything about row-level visibility without an account
# that is a Projektleitung -- but six known logins on a shared password are also
# exactly how an install ends up reachable months later, so:
#
#   * both variables are required; neither has a default;
#   * the seed prints why it declined when one is missing;
#   * leave them empty anywhere that is not a throwaway local database.
#
# The suite skips with a message when the password is absent, rather than
# failing -- a red suite on a machine that has not opted in is one people learn
# to ignore.
SEED_TEST_USERS=""
SEED_TEST_PASSWORD=""