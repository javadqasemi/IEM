{
  "name": "iem-cms-server",
  "version": "1.0.0",
  "private": true,
  "description": "IEM AG enterprise CMS — API, RBAC, workflow, media, audit",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.seed.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "//overrides": [
    "Transitive packages our direct dependencies pin to versions with published",
    "advisories. Each is held forward to the patched release; remove an entry",
    "once the parent ships it itself.",
    "  multer       — @nestjs/platform-express@11 pins 2.0.2; 2.3.0 fixes four",
    "                 DoS/limit-bypass advisories. This one matters: it parses",
    "                 the public application form's multipart body.",
    "  deepmerge-ts — via @prisma/config; stack exhaustion on recursive graphs.",
    "  mysql2       — via the Prisma CLI. Unused here (Postgres), but a",
    "                 vulnerable package in the tree is still a finding."
  ],
  "overrides": {
    "multer": "^2.4.0",
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.5",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.0.0",
    "iem-ui": "file:..",
    "nodemailer": "^10.0.10",
    "otpauth": "^9.3.6",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "prisma": "^7.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
