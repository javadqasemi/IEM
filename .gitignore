node_modules
dist
.DS_Store
*.local
.vite

# tsc -b incremental build stamp
tsconfig.tsbuildinfo

# Stray emit if noEmit is ever removed from tsconfig.json — these shadow the
# .tsx sources in Vite's resolution order and cause stale output.
src/**/*.js

# Real client models and drawings (Guglera, Giffers) — not ours to publish, and
# nothing in the build needs them: the components they generate are committed.
ifc/

# Python bytecode from the cad/ toolchain. Regenerated on every run and tied to
# the interpreter version it was written by.
__pycache__/
*.py[cod]

# Environment files. `.env.example` is the committed template; everything else
# holds real secrets. `*.local` above already covers `.env.local`.
.env
.env.production
.env.*.local

# Runtime data: uploads, generated media, job-application dossiers.
var/

# The build stamp (P2-6). Written by `npm run stamp` before a build and read
# by `resolveBuildInfo`; committing it would put a commit hash in the tree
# that is wrong the moment anybody commits again.
server/build-info.json
# Playwright
e2e/report/
e2e/shots/
e2e/last-run.log
test-results/
playwright-report/
blob-report/
playwright/.cache/
